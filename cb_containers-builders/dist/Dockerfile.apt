# ╔══════════════════════════════════════════════════════════════════╗
# ║ cloud-builder x86-apt                                          ║
# ║ ghcr.io/diegonmarcos/cloud-builder-x-deb-apt                    ║
# ║ Source: cb_containers-builders/src/Dockerfile.x86-apt          ║
# ║                                                                ║
# ║ Pure Debian builder — no Nix. Uses apt for all deps.           ║
# ║ Lighter + faster than nixos variant. For CI/CD pipelines.      ║
# ╚══════════════════════════════════════════════════════════════════╝

FROM debian:bookworm-slim

# ── System base ──────────────────────────────────────────────────
# NOTE: no apt nodejs/npm — bookworm ships node 18, too old for the
# declared npm globals (wrangler@4 requires >=22). Node comes from
# NodeSource below.
RUN apt-get update -qq && for pkg in \
    bash curl wget git git-lfs openssh-client rsync \
    jq sudo ca-certificates gnupg lsb-release \
    make gcc g++ python3 python3-pip \
    unzip xz-utils locales; do \
      apt-get install -y -qq --no-install-recommends "$pkg" 2>/dev/null \
      || echo "[SKIP] $pkg not available"; \
    done \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# ── Node 22 (NodeSource) ─────────────────────────────────────────
# Required by the smoke test + wrangler@4.x engine constraint.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y -qq --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Docker CLI ───────────────────────────────────────────────────
# MULTI-ARCH (2026-07-02): arch was hardcoded amd64 — the arm64 leg of
# ship-builders got exit 100 (no packages for arch). dpkg decides now.
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# ── sops + age ───────────────────────────────────────────────────
# Arch-dynamic: the old amd64-only URLs silently installed x86 binaries on
# arm64 (masked by the || SKIP) — sops/age would then exec-format-error.
# --retry IS LOAD-BEARING. GitHub's release CDN returns transient 503s, and a
# bare `curl -fsSL` here fails the whole image build on one bad second. On
# 2026-08-12 this exact line 503'd twice in one run:
#   #10 0.149 curl: (22) The requested URL returned error: 503
#   #11 0.218 curl: (22) The requested URL returned error: 503
#   tar: Error is not recoverable: exiting now
# and the build then died with the far less obvious
#   Required binaries missing from ...cloud-builder-x-deb-apt:amd64: sops age
# because `|| echo "[SKIP]"` swallows the curl failure and defers the error to
# the post-build binary check, which names the symptom instead of the cause.
# --retry-all-errors is required: plain --retry ignores HTTP 4xx/5xx and only
# retries transport-level errors, so it would NOT cover a 503.
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors "https://github.com/getsops/sops/releases/download/v3.9.4/sops-v3.9.4.linux.${ARCH}" -o /usr/local/bin/sops \
    && chmod +x /usr/local/bin/sops \
    || echo "[SKIP] sops install failed"
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors "https://github.com/FiloSottile/age/releases/download/v1.2.1/age-v1.2.1-linux-${ARCH}.tar.gz" -o /tmp/age.tgz \
    && tar xz -C /tmp -f /tmp/age.tgz \
    && mv /tmp/age/age /tmp/age/age-keygen /usr/local/bin/ && rm -rf /tmp/age /tmp/age.tgz \
    || echo "[SKIP] age install failed"

# ── Declared deps (terraform, rust, npm globals incl. wrangler) ──
# Same generated contract the nixhm variant runs — data-driven from
# .deps in the cloud config (docker-deps.sh is AUTO-GENERATED by
# cb_containers-builders/build.sh). Without it this image lacked
# wrangler and failed the ship-builders smoke test.
COPY docker-deps.sh /tmp/docker-deps.sh
RUN bash /tmp/docker-deps.sh && rm /tmp/docker-deps.sh

# ── gh CLI ───────────────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update -qq && apt-get install -y -qq gh \
    && rm -rf /var/lib/apt/lists/* \
    || echo "[SKIP] gh install failed"

# ── Node modules (tsx, yaml, nunjucks for cloud engine) ──────────
RUN mkdir -p /root/.node_modules && cd /root/.node_modules \
    && npm install --silent tsx yaml nunjucks 2>/dev/null \
    && echo "Node modules installed: $(ls node_modules | wc -l) packages"

# ── Self-documenting ─────────────────────────────────────────────
RUN mkdir -p /opt/cloud-builder
COPY Dockerfile.apt /opt/cloud-builder/Dockerfile
COPY docker/entrypoint.sh /opt/cloud-builder/entrypoint.sh
COPY docker/docker-up.sh /opt/cloud-builder/docker-up.sh
RUN chmod +x /opt/cloud-builder/entrypoint.sh /opt/cloud-builder/docker-up.sh

# ── Labels ───────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="cloud-builder-x-deb-apt"
LABEL org.opencontainers.image.description="cloud-builder — Debian apt CI/CD image (no Nix)"
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/unix"
LABEL diego.image.variant="x86-apt"
LABEL diego.image.ghcr="ghcr.io/diegonmarcos/cloud-builder-x-deb-apt"

ENV LANG=en_US.UTF-8
ENV NODE_PATH=/root/.node_modules/node_modules
ENV PATH="/root/.node_modules/node_modules/.bin:/usr/local/bin:/usr/bin:/bin:/sbin"

WORKDIR /workspace
ENTRYPOINT ["/opt/cloud-builder/entrypoint.sh"]
CMD []
