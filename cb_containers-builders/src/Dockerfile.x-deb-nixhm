# ╔══════════════════════════════════════════════════════════════════╗
# ║ cloud-builder — Debian flat OS + Nix + Home Manager            ║
# ║ ghcr.io/diegonmarcos/cloud-builder-x-deb-nixhm                ║
# ║ Source: cb_containers-builders/src/Dockerfile.x-deb-nixhm      ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║ Architecture:                                                   ║
# ║   1. Debian bookworm-slim base (flat OS, like VMs)              ║
# ║   2. Install nix (single-user, no daemon)                       ║
# ║   3. Build home-manager activation package                      ║
# ║   4. Activate HM → all tools installed via nix store            ║
# ║   5. nix develop locally = identical environment                ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Stage 1: Debian base with nix ───────────────────────────────
FROM debian:bookworm-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

# Minimal apt deps for nix installer + git operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils git ca-certificates sudo locales \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Install nix — single-user mode (no daemon, simpler for Docker)
# Pre-create nix.conf: disable build-users-group (no nixbld group in Docker)
RUN mkdir -p /etc/nix \
    && printf "build-users-group =\nexperimental-features = nix-command flakes\nsandbox = false\nfilter-syscalls = false\n" > /etc/nix/nix.conf \
    && curl -L https://nixos.org/nix/install | sh -s -- --no-daemon \
    && . /root/.nix-profile/etc/profile.d/nix.sh

# Make nix available for subsequent RUN commands
ENV PATH="/root/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH}"

# ── Stage 2: Build HM activation package ────────────────────────
FROM base AS builder

WORKDIR /build
COPY flake.nix flake.lock cloud-builder.nix ./

# Pass GITHUB_TOKEN for authenticated GitHub API requests (avoids rate limiting)
ARG GITHUB_TOKEN=""
RUN if [ -n "$GITHUB_TOKEN" ]; then \
      mkdir -p ~/.config/nix && \
      printf "access-tokens = github.com=%s\n" "$GITHUB_TOKEN" >> /etc/nix/nix.conf; \
    fi

# Update only config-json (lock already has home-manager + nixpkgs pinned)
RUN nix flake update config-json

# Build the home-manager activation package
# rm /homeless-shelter: nix creates it for sandboxless builds, terraform go-modules
# leaves it behind which breaks subsequent derivations
RUN rm -rf /homeless-shelter && \
    nix build '.#homeConfigurations."root@cloud-builder".activationPackage' \
    --no-link --print-out-paths > /build/hm-result-path.txt

# ── Stage 3: Final image ────────────────────────────────────────
FROM base

# Copy entire nix store from builder (HM closure + all deps)
COPY --from=builder /nix/store /nix/store
COPY --from=builder /nix/var /nix/var
COPY --from=builder /root/.nix-profile /root/.nix-profile
COPY --from=builder /root/.nix-defexpr /root/.nix-defexpr
COPY --from=builder /build/hm-result-path.txt /tmp/hm-result-path.txt

# Copy flake for nix develop at runtime
COPY --from=builder /build /opt/cloud-builder-flake

# Activate home-manager (installs all packages, sets up shell, PATH, etc.)
# HM activate requires USER and HOME to be set
ENV USER=root HOME=/root
RUN HM_PATH=$(cat /tmp/hm-result-path.txt) \
    && "$HM_PATH/activate" \
    && rm /tmp/hm-result-path.txt

# Self-documenting: entrypoint + helpers baked in
COPY docker/entrypoint.sh /opt/cloud-builder/entrypoint.sh
COPY docker/docker-up.sh /opt/cloud-builder/docker-up.sh
COPY docker/ship-hm.sh /opt/cloud-builder/ship-hm.sh
COPY docker/ship-services.sh /opt/cloud-builder/ship-services.sh
COPY docker/gen-configs.sh /opt/cloud-builder/gen-configs.sh
COPY docker/health.sh /opt/cloud-builder/health.sh
COPY docker/compose.yaml /opt/cloud-builder/compose.yaml
RUN chmod +x /opt/cloud-builder/*.sh

# Clone all repos (HTTPS, public) — entrypoint refreshes on start
RUN mkdir -p /root/git \
    && git config --global --add safe.directory "*" \
    && git clone --depth 1 --recurse-submodules https://github.com/diegonmarcos/cloud.git /root/git/cloud \
    && git clone --depth 1 https://github.com/diegonmarcos/unix.git /root/git/unix \
    && git clone --depth 1 https://github.com/diegonmarcos/diegonmarcos.github.io.git /root/git/front \
    && git clone --depth 1 https://github.com/diegonmarcos/front-data.git /root/git/front-data \
    && git clone --depth 1 https://github.com/diegonmarcos/cloud-data.git /root/git/cloud-data \
    && git clone --depth 1 https://github.com/diegonmarcos/tools.git /root/git/tools \
    && git clone --depth 1 https://github.com/diegonmarcos/diegonmarcos.git /root/git/diegonmarcos

ARG DOCKERFILE_B64=""
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud"
LABEL org.opencontainers.image.description="cloud-builder — Debian flat + nix + home-manager CI/CD image"

WORKDIR /root/git/cloud
ENTRYPOINT ["/opt/cloud-builder/entrypoint.sh"]
CMD []
