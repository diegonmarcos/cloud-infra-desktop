# ══════════════════════════════════════════════════════════════
# cloud-builder-x86-nixos-forge v2 — deps.json-driven
# ghcr.io/diegonmarcos/cloud-builder-x86-nixos-forge:latest
#
# deps.json = source of truth
# install.sh = reads deps.json, installs everything
# Dockerfile = just COPY + RUN install.sh <layer>
# ══════════════════════════════════════════════════════════════

FROM debian:bookworm

LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud"
LABEL org.opencontainers.image.title="cloud-builder-x86-nixos-forge"
LABEL org.opencontainers.image.description="Full dev/CI/ML builder — deps.json-driven, multi-arch"
LABEL org.opencontainers.image.authors="Diego Nepomuceno Marcos"
LABEL forge.deps="/etc/forge/deps.json"
LABEL forge.installer="/etc/forge/install.sh"
LABEL forge.dockerfiles="/root/Dockerfile"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
ENV PATH="/root/.cargo/bin:/usr/local/go/bin:/root/go/bin:/root/.local/bin:/root/.nix-profile/bin:/usr/local/cuda/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}"
ENV ANDROID_HOME=/opt/android-sdk
ENV CONNECTIQ_HOME=/opt/connectiq
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"

# Source of truth
COPY forge-deps.json /etc/forge/deps.json
COPY forge-install.sh /etc/forge/install.sh
RUN chmod +x /etc/forge/install.sh

# Layer 1: System packages (apt)
RUN /etc/forge/install.sh apt

# Layer 2: Rust
RUN /etc/forge/install.sh rust

# Layer 3: Go
RUN /etc/forge/install.sh go

# Layer 4: Node.js
RUN /etc/forge/install.sh node

# Layer 5: Python
RUN /etc/forge/install.sh pip

# Layer 6: Ruby gems + R packages
RUN /etc/forge/install.sh ruby
RUN /etc/forge/install.sh r

# Layer 7: Cloud CLIs (docker, kubectl, helm, terraform, gh, sops, age, starship, duf, act)
RUN /etc/forge/install.sh cloud

# Layer 8: Nix
RUN /etc/forge/install.sh nix
ENV NIX_PATH="nixpkgs=channel:nixos-24.11"

# Layer 9: CUDA
RUN /etc/forge/install.sh cuda

# Layer 10: Android + Kotlin
RUN /etc/forge/install.sh android

# Layer 11: Repos
RUN git config --global submodule.recurse true \
    && git config --global protocol.file.allow always \
    && git config --global init.defaultBranch main
RUN /etc/forge/install.sh repos

# Layer 12: Fish config (install.sh handles config creation)
RUN /etc/forge/install.sh fish

# Layer 13: Octocode
ARG OCTOCODE_VERSION=0.12.2
RUN curl -fsSL "https://github.com/Muvon/octocode/releases/download/${OCTOCODE_VERSION}/octocode-${OCTOCODE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    | tar -xzf - -C /usr/local/bin/ && chmod +x /usr/local/bin/octocode && octocode --version

# Layer 14: Embed Dockerfile + verify
COPY Dockerfile.x86-forge /root/Dockerfile
RUN /etc/forge/install.sh verify

WORKDIR /build
SHELL ["/usr/bin/fish", "-c"]
