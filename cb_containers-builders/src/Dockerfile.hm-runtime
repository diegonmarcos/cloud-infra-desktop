# ╔══════════════════════════════════════════════════════════════════╗
# ║ nix-hm-runtime — Minimal HM-transport base                       ║
# ║ ghcr.io/diegonmarcos/nix-hm-runtime                             ║
# ║ Source: cb_containers-builders/src/Dockerfile.hm-runtime         ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║ Used as the FROM-line for cloud's per-VM nixhm-sudo-<vm> images. ║
# ║ Its ONLY job is to be a vehicle that:                            ║
# ║   1. carries the per-VM nix-store closure (added as top layer)   ║
# ║   2. runs the activation container that cp's that closure to the ║
# ║      host's /nix/store                                           ║
# ║                                                                  ║
# ║ NOT a dev environment — no Diego profile, no fish/rust/go,       ║
# ║ no cloned repos, no dev tools. That's user-dev-x86-deb-nix-hm    ║
# ║ (a separate image used by `dtk.sh containers deb-nix`).          ║
# ║                                                                  ║
# ║ Expected size: ~1 GB compressed, ~2 GB uncompressed.             ║
# ║ Compare: user-dev-x86-deb-nix-hm = 3.3 GB uncompressed.          ║
# ║ Net savings on each cloud VM: ~2.3 GB per HM image base.         ║
# ╚══════════════════════════════════════════════════════════════════╝

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Minimal apt deps:
#   sudo            — HM activation runs `sudo $ACTIVATE/activate`
#   curl, xz-utils  — for the nix installer
#   ca-certificates — TLS to ghcr/nix substituters
#   locales         — HM activation script localized strings
#   git             — HM activation may reference git for some derivations
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        sudo curl xz-utils ca-certificates locales git \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Install nix (single-user, no daemon — simpler in a container).
# sandbox=false: docker build RUN can't create user namespaces.
# filter-syscalls=false: avoid seccomp conflicts.
RUN mkdir -p /etc/nix \
    && printf "build-users-group =\nexperimental-features = nix-command flakes\nsandbox = false\nfilter-syscalls = false\n" > /etc/nix/nix.conf \
    && curl -L https://nixos.org/nix/install | sh -s -- --no-daemon

ENV PATH="/root/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH}"

LABEL org.opencontainers.image.title="nix-hm-runtime"
LABEL org.opencontainers.image.description="Minimal HM-transport base — debian + nix multi-user only. Used as FROM for cloud's nixhm-sudo-<vm> per-VM images. NOT a dev environment (see user-dev-x86-deb-nix-hm for that)."
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/unix"
LABEL org.opencontainers.image.url="https://github.com/diegonmarcos/unix/tree/main/cb_containers-builders/src"
LABEL org.opencontainers.image.vendor="Diego Nepomuceno Marcos"
LABEL org.opencontainers.image.licenses="MIT"

# No CMD/ENTRYPOINT — the per-VM HM image's Dockerfile (built per-ship by
# cloud-ship-nix-homemanager-step-build-docker.sh) sets its own ENTRYPOINT
# to /hm/activate.sh. This base image is purely a foundation.
