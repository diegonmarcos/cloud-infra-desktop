{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cloud-terminal",
  "version": "1.0.0",
  "identifier": "com.diegonmarcos.cloud-terminal",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Cloud Terminal",
    "longDescription": "Registry-driven multi-profile terminal with per-profile system tray."
  }
}
