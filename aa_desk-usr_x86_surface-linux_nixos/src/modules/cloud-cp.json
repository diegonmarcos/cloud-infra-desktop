      "name": "KDE",
      "items": [
        { "label": "KDE Connect Devices",  "type": "shell", "arg": "kdeconnect-cli --list-devices --verbose 2>/dev/null || echo 'kdeconnect-cli not found'", "icon": "kdeconnect" },
        { "label": "Available Devices",    "type": "shell", "arg": "kdeconnect-cli --list-available 2>/dev/null || echo 'kdeconnect-cli not found'",          "icon": "network-bluetooth" },
        { "label": "System Resources",     "type": "shell", "arg": "free -h && echo && df -h / /nix",                                                         "icon": "utilities-system-monitor" },
