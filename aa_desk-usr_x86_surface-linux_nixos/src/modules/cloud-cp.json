      "name": "Network",
      "items": [
        { "label": "WireGuard Status",    "type": "shell",  "arg": "sudo wg show all",                                          "icon": "network-vpn" },
        { "label": "Mesh Peers",          "type": "shell",  "arg": "sudo wg show all peers latest-handshakes",                   "icon": "network-wired" },
        { "label": "DNS Status",          "type": "shell",  "arg": "resolvectl status",                                          "icon": "network-server" },
        { "label": "Firewall Rules",      "type": "shell",  "arg": "sudo iptables -L -n --line-numbers 2>/dev/null || sudo nft list ruleset", "icon": "security-high" },
        { "label": "Network Interfaces",  "type": "shell",  "arg": "ip a && ip r",                                               "icon": "network-wired" },
        { "label": "Ping Mesh (all VMs)", "type": "shell",  "arg": "for ip in 10.0.0.1 10.0.0.3 10.0.0.4 10.0.0.6; do printf \"%-12s \" $ip; ping -c1 -W1 $ip >/dev/null 2>&1 && echo OK || echo FAIL; done", "icon": "network-workgroup" }
      ]
    },
