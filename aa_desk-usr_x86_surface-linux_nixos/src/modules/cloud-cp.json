    {
      "name": "Cloud — VMs",
      "items": [
        { "label": "SSH: gcp-proxy",    "type": "shell", "arg": "ssh gcp-proxy 'uptime && echo && df -h / && echo && docker ps --format \"table {{.Names}}\\t{{.Status}}\"'",    "icon": "network-server" },
        { "label": "SSH: oci-apps",     "type": "shell", "arg": "ssh oci-apps  'uptime && echo && df -h / && echo && docker ps --format \"table {{.Names}}\\t{{.Status}}\"'",    "icon": "network-server" },
        { "label": "SSH: oci-analytics","type": "shell", "arg": "ssh oci-analytics 'uptime && echo && df -h / && echo && docker ps --format \"table {{.Names}}\\t{{.Status}}\"'","icon": "network-server" },
        { "label": "SSH: oci-mail",     "type": "shell", "arg": "ssh oci-mail  'uptime && echo && df -h / && echo && docker ps --format \"table {{.Names}}\\t{{.Status}}\"'",    "icon": "network-server" }
      ]
