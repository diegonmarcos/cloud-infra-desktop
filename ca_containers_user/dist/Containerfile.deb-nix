# ╔══════════════════════════════════════════════════════════════════╗
# ║ Diego's Dev Environment — user-dev-x86-deb-nix-hm             ║
# ║                                                                ║
# ║ Multi-stage: build nix/HM in stage 1, copy clean closure      ║
# ║ to fresh Debian in stage 2. No layer garbage.                  ║
# ║                                                                ║
# ║ Build:  docker build -t ghcr.io/diegonmarcos/user-dev-x86-deb-nix-hm .    ║
# ║ Push:   docker push ghcr.io/diegonmarcos/user-dev-x86-deb-nix-hm:latest   ║
# ║ Run:    sh ~/git/cloud-mykonsole-dtk/dtk.sh containers deb-nix {cli|gui|tty}║
# ╚══════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════
# STAGE 1: Builder — install nix + HM, garbage collect, done
# ═══════════════════════════════════════════════════════════════════
FROM debian:bookworm-slim AS builder

RUN apt-get update -qq && apt-get install -y -qq \
    sudo curl git xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -G sudo diego \
    && echo "diego ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER diego
WORKDIR /home/diego

# Install Nix
ENV PATH="/home/diego/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
RUN curl -L https://releases.nixos.org/nix/nix-2.28.3/install | sh -s -- --no-daemon \
    && mkdir -p /home/diego/.config/nix \
    && echo "experimental-features = nix-command flakes" > /home/diego/.config/nix/nix.conf

# Setup channels
RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh \
    && nix-channel --add https://github.com/nix-community/home-manager/archive/release-24.11.tar.gz home-manager \
    && nix-channel --add https://nixos.org/channels/nixos-24.11 nixpkgs \
    && nix-channel --update

# Clone repos
RUN mkdir -p /home/diego/git && cd /home/diego/git \
    && git clone --depth 1 https://github.com/diegonmarcos/cloud-unix.git \
    && git clone --depth 1 https://github.com/diegonmarcos/cloud-infra.git \
    && git clone --depth 1 https://github.com/diegonmarcos/cloud-data.git \
    && git clone --depth 1 https://github.com/diegonmarcos/diegonmarcos.github.io.git front \
    && git clone --depth 1 https://github.com/diegonmarcos/front-data.git \
    && git clone --depth 1 https://github.com/diegonmarcos/cloud-mykonsole-dtk.git

# Home-manager switch (diego@cli = exact desktop match)
RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh \
    && cd /home/diego/git/cloud-unix/ba_flakes_desktop/src \
    && nix run home-manager/release-24.11 -- switch --flake .#diego@cli --impure 2>&1 \
    && echo "HOME-MANAGER: SUCCESS" \
    || echo "HOME-MANAGER: FAILED — fallback below"

# Fallback: nix profile install (idempotent)
RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#fish nixpkgs#starship nixpkgs#eza nixpkgs#bat \
       nixpkgs#fd nixpkgs#ripgrep nixpkgs#fzf nixpkgs#delta nixpkgs#zoxide \
       nixpkgs#jq nixpkgs#yq-go \
    || true

RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#rustup nixpkgs#go nixpkgs#nodejs_22 nixpkgs#python312 \
       nixpkgs#gcc nixpkgs#gnumake nixpkgs#cmake \
    || true

RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#git nixpkgs#git-lfs nixpkgs#openssh nixpkgs#curl \
       nixpkgs#wget nixpkgs#htop nixpkgs#tmux nixpkgs#vim nixpkgs#tree nixpkgs#ncdu nixpkgs#ttyd \
    || true

RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#docker-client nixpkgs#terraform nixpkgs#sops nixpkgs#age \
    || true

RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#nmap nixpkgs#wireguard-tools nixpkgs#openssl nixpkgs#gnupg \
    || true

RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh && export NIXPKGS_ALLOW_UNFREE=1 \
    && nix profile install --impure \
       nixpkgs#shellcheck nixpkgs#shfmt nixpkgs#direnv \
    || true

# Aggressive cleanup — this is the last step in the builder
RUN . /home/diego/.nix-profile/etc/profile.d/nix.sh \
    && nix-collect-garbage -d 2>/dev/null \
    && nix store optimise 2>/dev/null \
    && rm -rf /home/diego/.cache/nix \
    || true

# ═══════════════════════════════════════════════════════════════════
# STAGE 2: Final — clean Debian + only the nix closure
# ═══════════════════════════════════════════════════════════════════
FROM debian:bookworm-slim

# ── OCI Standard Labels ──────────────────────────────────────────
LABEL org.opencontainers.image.title="user-dev-x86-deb-nix-hm"
LABEL org.opencontainers.image.description="Diego's portable dev environment — Debian + Nix Home-Manager (diego@cli profile)"
LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/cloud-unix"
LABEL org.opencontainers.image.url="https://github.com/diegonmarcos/cloud-unix/tree/main/ca_containers_user/src"
LABEL org.opencontainers.image.documentation="https://github.com/diegonmarcos/cloud-unix/blob/main/README.md"
LABEL org.opencontainers.image.vendor="Diego Nepomuceno Marcos"
LABEL org.opencontainers.image.authors="Diego Nepomuceno Marcos <me@diegonmarcos.com>"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.base.name="debian:bookworm-slim"
LABEL org.opencontainers.image.ref.name="latest"

# ── Diego Custom Labels ──────────────────────────────────────────
LABEL diego.image.name="user-dev-x86-deb-nix-hm"
LABEL diego.image.type="dev-environment"
LABEL diego.image.variant="deb-nix"
LABEL diego.image.profiles="cli,gui,tty"
LABEL diego.image.runner="~/git/cloud-mykonsole-dtk/dtk.sh containers deb-nix {cli|gui|tty}"
LABEL diego.image.flake.repo="github.com/diegonmarcos/cloud-unix"
LABEL diego.image.flake.path="ba_flakes_desktop/src/"
LABEL diego.image.flake.config="diego@cli"
LABEL diego.image.flake.toolsets="shell-core dev-languages build-debug containers-cloud security-network data-science"
LABEL diego.image.container.path="ca_containers_user/src/"
LABEL diego.image.compose.path="ca_containers_user/dist/compose-deb-nix.yaml"
LABEL diego.image.dockerfile.path="ca_containers_user/src/Containerfile.deb-nix"
LABEL diego.image.ghcr="ghcr.io/diegonmarcos/user-dev-x86-deb-nix-hm"
LABEL diego.image.nix.channel="nixos-24.11"
LABEL diego.image.home-manager="release-24.11"
LABEL diego.image.shell.default="fish"
LABEL diego.image.user="diego"
LABEL diego.image.uid="1000"
LABEL diego.image.embedded="/home/diego/.image-meta/ (Containerfile + compose.yaml)"
LABEL diego.image.packages.shell="fish starship eza bat fd ripgrep fzf delta zoxide jq yq-go"
LABEL diego.image.packages.lang="rustup go nodejs python ruby gcc llvm cmake ninja"
LABEL diego.image.packages.cloud="docker-client kubectl helm terraform sops age"
LABEL diego.image.packages.net="nmap mtr wireguard-tools openssl gnupg"
LABEL diego.image.packages.node="pnpm typescript sass"
LABEL diego.image.packages.tools="shellcheck shfmt just watchexec direnv ttyd"
LABEL diego.image.build="multi-stage (no layer garbage)"

# Minimal system deps (locale, sudo, git for runtime)
RUN apt-get update -qq && apt-get install -y -qq \
    sudo curl git locales ca-certificates \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Recreate diego user (same UID so nix store ownership matches)
RUN useradd -m -s /bin/bash -G sudo -u 1000 diego \
    && echo "diego ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy clean nix store from builder (no intermediate garbage)
COPY --from=builder --chown=diego:diego /nix /nix

# Copy user home (nix profile links, HM state, git repos, configs)
COPY --from=builder --chown=diego:diego /home/diego /home/diego

# Embed build files + compose (self-documentation)
RUN mkdir -p /home/diego/.image-meta
COPY --chown=diego:diego Containerfile.deb-nix /home/diego/.image-meta/Containerfile
COPY --chown=diego:diego compose-*.yaml /home/diego/.image-meta/

USER diego
WORKDIR /home/diego

ENV PATH="/home/diego/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV SHELL=/home/diego/.nix-profile/bin/fish
ENV TERM=xterm-256color
ENV HOME=/home/diego
ENV USER=diego

CMD ["fish"]
