+function resolveGhRepo(): string {
+  try {
+    const { getConfig } = require("../../shared/libs/config.js");
+    const config = getConfig();
+    return `${config.owner?.github ?? "diegonmarcos"}/cloud`;
+  } catch {}
+  return "diegonmarcos/cloud";
+}
+const GH_REPO = resolveGhRepo();
