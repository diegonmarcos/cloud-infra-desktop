+// ──────────────────────────────────────────────────────────────────────────────
+// HELPERS
+// ──────────────────────────────────────────────────────────────────────────────
+
+// NB: the identical helper in workflows.ts / finops.ts / vps-ops.ts omits the
+// callback return annotations, so TS widens the tuple to an array and each copy
+// contributes a TS2322. Annotating both callbacks keeps the tuple type and
+// costs nothing — this copy is clean rather than adding to that debt.
+type TextResult = { content: [{ type: "text"; text: string }] };
+
+function safeRun(fn: () => Promise<string>): Promise<TextResult> {
+  return fn()
+    .then((text): TextResult => ({ content: [{ type: "text" as const, text }] }))
+    .catch((err): TextResult => ({ content: [{ type: "text" as const, text: `ERROR: ${err instanceof Error ? err.message : String(err)}` }] }));
+}
+
+// execAsync spawns with an argv ARRAY — there is no shell, so nothing here is a
+// shell-injection surface. The validation below is about FLAG injection: gh
+// parses a leading "-" as an option, so an unvalidated value could smuggle one.
+async function gh(args: string[], timeout = 30_000, input?: string): Promise<{ ok: boolean; stdout: string; stderr: string }> {
+  const r = await execAsync("gh", args, { timeout, input });
+  return { ok: r.ok, stdout: r.stdout, stderr: r.stderr };
+}
+
+const RE_REPO = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;
+const RE_NUM = /^\d+$/;
+const RE_FIELD = /^[A-Za-z_][A-Za-z0-9_.\[\]-]*$/;
+const RE_SECRET = /^[A-Za-z_][A-Za-z0-9_]*$/;
+
+function badRepo(repo: string): string | null {
+  return RE_REPO.test(repo) ? null : `✗ invalid repo "${repo}" — expected owner/name`;
+}
+function badNum(v: string, label: string): string | null {
+  return RE_NUM.test(v) ? null : `✗ invalid ${label} "${v}" — expected digits`;
+}
+// A positional value starting with "-" would be read by gh as a flag.
+function badPositional(v: string, label: string): string | null {
+  return v.startsWith("-") ? `✗ ${label} may not start with "-"` : null;
+}
+
+// A diff, a log or an api response can be megabytes. Never hand that back whole.
+function tail(text: string, max = 300): string {
+  const lines = text.split("\n");
+  if (lines.length <= max) return text;
+  return [`(${lines.length - max} earlier lines trimmed)`, ...lines.slice(-max)].join("\n");
+}
+
+function out(r: { ok: boolean; stdout: string; stderr: string }, okMsg?: string, max = 300): string {
+  if (!r.ok) return `✗ ${r.stderr.trim() || r.stdout.trim() || "gh failed with no output"}`;
+  const body = r.stdout.trim();
+  if (okMsg) return body ? `${okMsg}\n${tail(body, max)}` : okMsg;
+  return body ? tail(body, max) : "(no output)";
+}
