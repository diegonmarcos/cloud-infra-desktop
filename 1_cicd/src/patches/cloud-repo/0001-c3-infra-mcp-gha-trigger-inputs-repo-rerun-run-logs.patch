+// bearer token valid until 2036, alongside devops.docker.exec and
+// devops.vm.reset — an accidental merge, release deletion or secret removal is
+// a real failure mode, and a confirm flag makes intent explicit without
+// blocking anything a caller actually meant to do.
+function needConfirm(confirm: boolean | undefined, what: string): string | null {
+  return confirm === true ? null : `✗ refused: ${what} is destructive — pass confirm=true to proceed`;
+}
