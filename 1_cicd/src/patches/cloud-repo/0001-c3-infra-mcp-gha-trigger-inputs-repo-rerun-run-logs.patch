+      return out(await gh(["api", q, "--jq", '.[] | {sha: .sha[0:8], msg: (.commit.message | split("\n")[0]), author: .commit.author.name, date: .commit.author.date}']));
+    }),
+  );
+
+  // ── Actions secrets ─────────────────────────────────────────────────────
+  server.tool(
+    "devops.gh.secret_list",
+    "List Actions secret NAMES and their updated-at. Values are never returned — GitHub stores them one-way encrypted and no API can read them back.",
+    { repo: repoArg },
+    ({ repo }) => safeRun(async () => {
+      const t = R(repo); const e = badRepo(t); if (e) return e;
+      return out(await gh(["secret", "list", "--repo", t]));
+    }),
+  );
+
+  server.tool(
+    "devops.gh.secret_set",
+    "Create or update an Actions secret. The value is passed to gh on STDIN, never in argv — a --body argument would be visible to anyone running `ps` on the host. The value is never logged or echoed back.",
+    { name: z.string(), value: z.string(), repo: repoArg },
+    ({ name, value, repo }) => safeRun(async () => {
+      const t = R(repo); const e = badRepo(t); if (e) return e;
+      if (!RE_SECRET.test(name)) return `✗ invalid secret name "${name}" — expected [A-Za-z_][A-Za-z0-9_]*`;
+      log(`secret_set ${name} in ${t} (value withheld)`);
+      const r = await gh(["secret", "set", name, "--repo", t], 30_000, value);
+      // Deliberately does NOT echo the value, and reports gh's stderr only.
+      return r.ok ? `✓ secret ${name} set in ${t}` : `✗ failed to set ${name} — ${r.stderr.trim()}`;
+    }),
+  );
+
+  server.tool(
+    "devops.gh.secret_delete",
+    "Delete an Actions secret. DESTRUCTIVE — requires confirm=true. A workflow depending on it will start failing.",
+    { name: z.string(), confirm: z.boolean().optional(), repo: repoArg },
+    ({ name, confirm, repo }) => safeRun(async () => {
+      const t = R(repo); const e = badRepo(t) ?? needConfirm(confirm, `deleting secret ${name}`); if (e) return e;
+      if (!RE_SECRET.test(name)) return `✗ invalid secret name "${name}"`;
+      return out(await gh(["secret", "delete", name, "--repo", t]), `✓ deleted secret ${name}`);
+    }),
+  );
+
+  // ── Generic escape hatch ────────────────────────────────────────────────
+  server.tool(
+    "devops.gh.api",
+    "Call any GitHub REST/GraphQL endpoint via `gh api` — the catch-all for anything not wrapped above (deployments, environments, checks, collaborators, webhooks…). Non-GET methods are destructive and require confirm=true. Output is truncated to 300 lines.",
+    {
+      endpoint: z.string().describe('e.g. "repos/{owner}/{repo}/actions/runs" or "graphql"'),
+      method: z.enum(["GET", "POST", "PATCH", "PUT", "DELETE"]).optional(),
+      fields: z.record(z.string()).optional().describe("-f key=value pairs"),
+      jq: z.string().optional().describe("jq filter applied by gh"),
+      confirm: z.boolean().optional(),
+      repo: repoArg,
+    },
+    ({ endpoint, method, fields, jq, confirm, repo }) => safeRun(async () => {
+      const t = R(repo); const e = badRepo(t); if (e) return e;
+      const m = method ?? "GET";
+      if (m !== "GET") { const c = needConfirm(confirm, `a ${m} to ${endpoint}`); if (c) return c; }
+      const b = badPositional(endpoint, "endpoint"); if (b) return b;
+      const a = ["api", endpoint, "--method", m];
+      for (const [k, v] of Object.entries(fields ?? {})) {
+        if (!RE_FIELD.test(k)) return `✗ invalid field name "${k}"`;
+        if (/[\r\n]/.test(v)) return `✗ field "${k}" contains a newline`;
+        a.push("-f", `${k}=${v}`);
+      }
+      if (jq) a.push("--jq", jq);
+      return out(await gh(a, 60_000));
+    }),
+  );
+}
