{
  "meta": {
    "name": "Kali Linux Surface Security",
    "version": "1.0",
    "target": "Surface Pro 8",
    "distro": "kali-rolling"
  },
  "users": {
    "diego": {
      "shell": "/usr/bin/fish",
      "groups": ["sudo", "audio", "video", "plugdev", "netdev"],
      "sudo": "NOPASSWD"
    }
  },
  "repos": {
    "linux-surface": {
      "name": "linux-surface",
      "url": "https://pkg.surfacelinux.com/debian",
      "key_url": "https://raw.githubusercontent.com/linux-surface/linux-surface/master/pkg/keys/surface.asc",
      "key_file": "/etc/apt/trusted.gpg.d/linux-surface.gpg"
    },
    "github-cli": {
      "name": "github-cli",
      "url": "https://cli.github.com/packages",
      "key_url": "https://cli.github.com/packages/githubcli-archive-keyring.gpg",
      "key_file": "/usr/share/keyrings/githubcli-archive-keyring.gpg",
      "sources_file": "/etc/apt/sources.list.d/github-cli.list"
    },
    "brave": {
      "name": "brave-browser",
      "url": "https://brave-browser-apt-release.s3.brave.com/",
      "key_url": "https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg",
      "key_file": "/usr/share/keyrings/brave-browser-archive-keyring.gpg",
      "sources_file": "/etc/apt/sources.list.d/brave-browser-release.list"
    }
  },
  "apt": {
    "surface": ["linux-image-surface", "linux-headers-surface", "iptsd"],
    "base": ["build-essential", "linux-headers-amd64"],
    "shells": ["bash", "zsh", "fish"],
    "editors": ["vim", "nano", "neovim"],
    "network": ["network-manager", "wpasupplicant", "openssh-server", "curl", "wget", "git", "iwd"],
    "graphics": ["xorg", "openbox", "xterm", "mesa-utils", "fonts-dejavu", "fonts-liberation"],
    "wayland": ["sway", "foot", "wofi", "wl-clipboard"],
    "browsers": ["lynx", "firefox-esr", "brave-browser"],
    "monitors": ["btop", "htop"],
    "dev": ["nodejs", "npm", "python3", "python3-pip", "python3-venv"],
    "utils": ["sudo", "grub-efi-amd64", "efibootmgr", "dosfstools", "e2fsprogs", "cryptsetup", "btrfs-progs"],
    "cli_tools": ["ripgrep", "fd-find", "fzf", "jq", "tmux", "neofetch", "eza", "bat", "zoxide", "gh", "gocryptfs"],
    "gui_apps": ["pcmanfm", "lxappearance"],
    "kali_core": ["kali-linux-core"],
    "kali_tools": ["nmap", "netcat-openbsd", "tcpdump", "wireshark", "aircrack-ng", "john", "hashcat", "hydra", "sqlmap", "metasploit-framework", "burpsuite"]
  },
  "npm": {
    "global": ["@anthropic-ai/claude-code"]
  },
  "services": {
    "enable": ["NetworkManager", "ssh", "iptsd", "bluetooth", "nix-daemon"]
  },
  "nix": {
    "installer": "https://install.determinate.systems/nix",
    "mode": "multi-user",
    "daemon": "nix-daemon.service",
    "note": "Determinate Systems installer — survives upgrades, uninstall via /nix/nix-installer uninstall"
  },
  "mounts": {
    "luks_pool": {
      "_warning_2026-05-15": "Kali is the rescue unit and DOES need pool access for actual rescue work. UNLIKE rescue-os-debian (where we removed this entry), Kali keeps it. BUT: any time Kali mounts the pool, it MUST first invalidate any pending NixOS hibernate image on the swap target (mkswap -L Shared-Lib-swap /dev/disk/by-label/Shared-Lib), otherwise a subsequent NixOS boot will resume from a stale image after Kali modified pool state. See incident_2026-05-15_pool_hibernate_corruption.md.",
      "device": "UUID=3c75c6db-4d7c-4570-81f1-02d168781aac",
      "luks_name": "pool",
      "mountpoint": "/mnt/pool",
      "fstype": "btrfs",
      "options": "defaults,noauto,compress=zstd"
    },
    "shared_lib": {
      "device": "UUID=7e3626ac-ce13-4adc-84e2-1a843d7e2793",
      "mountpoint": "/mnt/shared-lib",
      "fstype": "ext4",
      "options": "defaults,noauto"
    }
  },

  "swap": {
    "_description": "Native Kali swap on p7 root. Added 2026-05-15 after OOM-killed nixos-install + konsole during pool reinstall (Kali had ZERO swap, ran out of RAM on a 4 GiB+ nix build). 2 GiB is sized for rescue OS workloads — Kali isn't a daily driver, just enough headroom for big builds + browser. Separate from the NixOS hibernate target at /mnt/shared-lib/.swapfile so Kali's swap pages never overwrite a pending NixOS hibernate image.",
    "swapfile": "/swapfile",
    "size_gib": 2,
    "label": "kali-swap",
    "priority": 50,
    "fstab_entry": "/swapfile none swap defaults 0 0",
    "create_commands": [
      "sudo fallocate -l 2G /swapfile",
      "sudo chmod 0600 /swapfile",
      "sudo mkswap -L kali-swap /swapfile",
      "sudo swapon -p 50 /swapfile",
      "echo '/swapfile none swap defaults 0 0' | sudo tee -a /etc/fstab"
    ]
  },
  "webserver": {
    "name": "http-dev",
    "description": "Node.js file server with Markdown rendering + Eruda DevTools — mirrors ba_flakes_desktop web-server-md-eruda.nix",
    "port": 8000,
    "assets": [
      "dotfiles/web-server-md-eruda.mjs -> ~/.local/bin/",
      "dotfiles/httpd-lib/ -> ~/.local/lib/httpd/"
    ],
    "wrapper": "~/.local/bin/http-dev",
    "service": "~/.config/systemd/user/http-dev.service",
    "deploy": "./install.sh webserver"
  },
  "install_order": [
    "1. Boot Kali with linux-surface kernel",
    "2. Run ./install.sh surface (verify drivers)",
    "3. Run ./install.sh scan (check what's missing)",
    "4. Run ./install.sh install (install all)",
    "5. Run ./install.sh kali (install security tools)",
    "6. Run ./install.sh webserver (deploy http-dev file server)"
  ]
}
