{
  "meta": {
    "name": "Kali Linux Container",
    "version": "1.0",
    "description": "Full Kali Linux toolset in a container with CLI and GUI (noVNC) modes",
    "distro": "kali-rolling"
  },
  "image": {
    "_description": "Upstream base image (input to Dockerfile.base / kali-lib).",
    "registry": "docker.io",
    "repo": "kalilinux/kali-rolling",
    "tag": "latest"
  },
  "images": {
    "_description": "Two-image split for build-time efficiency. kali-lib carries the heavy kali-linux-everything layer (~33 GB, rarely rebuilt). kali-os is a thin overlay (~50 MiB unique) FROM kali-lib carrying entrypoint + user + runtime helpers; rebuilt on every config change. Both pushed to GHCR independently — Docker layer-shares the heavy layer at pull time, so users get one combined runtime image without duplication.",
    "lib": {
      "local_tag": "kali-lib:latest",
      "dockerfile": "Dockerfile.base",
      "ghcr_name": "kali-lib",
      "ghcr_tags": ["latest"],
      "_description": "Heavy stage — apt + base + GUI + kali-linux-everything"
    },
    "os": {
      "local_tag": "kali-os:latest",
      "dockerfile": "Dockerfile.runtime",
      "from": "kali-lib:latest",
      "ghcr_name": "kali-os",
      "ghcr_tags": ["latest", "full"],
      "_description": "Thin overlay — entrypoint, user, runtime helpers (jq). FROM kali-lib."
    }
  },
  "ghcr": {
    "registry": "ghcr.io",
    "owner": "diegonmarcos",
    "auth": {
      "username_env": "GHCR_USER",
      "username_default": "diegonmarcos",
      "token_env": "GHCR_TOKEN",
      "token_cmd": "gh auth token"
    }
  },
  "container": {
    "name": "kali-linux",
    "hostname": "kali",
    "network_mode": "host",
    "restart": "unless-stopped",
    "shm_size": "2g",
    "cap_add": ["NET_ADMIN", "NET_RAW", "SYS_PTRACE"],
    "security_opt": ["seccomp=unconfined", "apparmor=unconfined", "no-new-privileges:false"]
  },
  "user": {
    "name": "kali",
    "uid": 1000,
    "gid": 1000,
    "shell": "/usr/bin/zsh",
    "groups": ["sudo", "audio", "video", "plugdev", "netdev"]
  },
  "apt": {
    "metapackages": ["kali-linux-everything"],
    "runtime_helpers": [
      "jq"
    ],
    "gui_stack": [
      "xfce4",
      "xfce4-goodies",
      "dbus-x11",
      "tigervnc-standalone-server",
      "tigervnc-common",
      "novnc",
      "websockify",
      "xterm",
      "fonts-dejavu",
      "fonts-liberation"
    ],
    "base": [
      "sudo",
      "curl",
      "wget",
      "git",
      "vim",
      "tmux",
      "zsh",
      "ca-certificates",
      "openssh-client",
      "iproute2",
      "iputils-ping",
      "net-tools",
      "dnsutils",
      "procps",
      "psmisc",
      "less",
      "locales",
      "tzdata"
    ]
  },
  "modes": {
    "cli": {
      "description": "Headless terminal (docker exec or attach)",
      "entrypoint_arg": "cli",
      "command": "/bin/zsh"
    },
    "gui": {
      "description": "XFCE4 desktop via TigerVNC + noVNC (browser)",
      "entrypoint_arg": "gui",
      "vnc_port": 5901,
      "novnc_port": 6901,
      "display": ":1",
      "geometry": "1920x1080",
      "depth": 24
    }
  },
  "volumes": {
    "home":      { "host": "./data/home",      "container": "/home/kali",  "description": "Persistent user home"   },
    "workspace": { "host": "./data/workspace", "container": "/workspace",  "description": "Pentest workspace"      },
    "loot":      { "host": "./data/loot",      "container": "/loot",       "description": "Captures, hashes, etc." }
  },
  "env": {
    "TZ": "Europe/Madrid",
    "LANG": "en_US.UTF-8",
    "VNC_PASSWORD_FILE": "/home/kali/.vnc/passwd"
  },
  "secrets": {
    "vnc_password_var": "KALI_VNC_PASSWORD",
    "vnc_password_default": "kali"
  }
}
