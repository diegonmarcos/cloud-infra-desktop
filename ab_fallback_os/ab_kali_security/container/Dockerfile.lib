# syntax=docker/dockerfile:1.7
# STAGE 2 — full pentest toolkit on top of kali-os.
# Output: kali-lib:latest
# Pushed independently to GHCR as ghcr.io/diegonmarcos/kali-lib:{latest,full}.
#
# What this adds on top of kali-os:
#   - APT_GUI (xfce4 + xfce4-goodies + tigervnc + novnc + websockify + xterm + fonts) ~832 MB
#   - APT_META (kali-linux-everything — every Kali tool) ~33 GB
#   - noVNC index alias
#
# kali-lib is `FROM kali-os` so it inherits the kali user, entrypoint, and
# locales. Boot kali-lib for `gui` mode or any service that needs the
# pentest toolkit. Boot kali-os alone for fast `cli` mode.
ARG BASE_TAG=kali-os:latest
FROM ${BASE_TAG}

LABEL org.opencontainers.image.source="https://github.com/diegonmarcos/unix" \
      org.opencontainers.image.description="Kali Linux — full toolset (kali-linux-everything) + GUI (XFCE/noVNC). FROM kali-os." \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.title="kali-lib" \
      org.opencontainers.image.documentation="https://github.com/diegonmarcos/unix/tree/main/ab_fallback_os/ab_kali_security/container"

ARG APT_GUI=""
ARG APT_META=""
ARG USER_NAME=kali

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 1) GUI stack (XFCE + VNC + noVNC).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ${APT_GUI} \
 && rm -rf /var/lib/apt/lists/*

# 2) Kali metapackage (kali-linux-everything ~ very large).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ${APT_META} \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# 3) noVNC index alias (needs novnc from APT_GUI above).
RUN if [ -d /usr/share/novnc ] && [ ! -e /usr/share/novnc/index.html ]; then \
      ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html; \
    fi

USER ${USER_NAME}
WORKDIR /home/${USER_NAME}

# Inherit ENTRYPOINT + CMD from kali-os.
