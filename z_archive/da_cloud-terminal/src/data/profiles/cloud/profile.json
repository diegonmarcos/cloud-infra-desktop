        },
        {
          "label": "Network Interfaces",
          "type": "shell",
          "arg": "ip a && ip r"
        },
        {
          "label": "Ping Mesh (all VMs)",
          "type": "shell",
          "arg": "for ip in 10.0.0.1 10.0.0.3 10.0.0.4 10.0.0.6; do printf '%-12s ' $ip; ping -c1 -W1 $ip >/dev/null 2>&1 && echo OK || echo FAIL; done"
        }
