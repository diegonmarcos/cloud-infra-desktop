{
  "name": "nix-flakes",
  "order": 4,
  "display_name": "Nix Flakes",
  "logo": "❄️",
  "tray_tooltip": "Nix Flakes — Control Panel",
  "theme": {
    "accent": "#7b7fff",
    "accent2": "#a78bfa",
    "bg": "#0e0f1a"
  },
  "flake": "/home/diego/git/cloud-unix/aa_desk-usr_x86_surface-linux_nixos",
  "flakes": {
    "system": "/home/diego/git/cloud-unix/aa_desk-usr_x86_surface-linux_nixos",
    "desktop": "/home/diego/git/cloud-unix/ba_flakes_desktop",
    "cloud": "/home/diego/git/cloud-infra"
  },
  "sections": [
    {
      "title": "Build",
      "items": [
        {
          "label": "Switch",
          "type": "build",
          "arg": "switch"
        },
        {
          "label": "Dry Run",
          "type": "build",
          "arg": "dry-run"
        },
        {
          "label": "Boot",
          "type": "build",
          "arg": "boot"
        },
        {
          "label": "Test",
          "type": "build",
          "arg": "test"
        },
        {
          "label": "Update",
          "type": "build",
          "arg": "update"
        },
        {
          "label": "Diff",
          "type": "build",
          "arg": "diff"
        }
      ]
    },
    {
      "title": "Desktop",
      "items": [
        {
          "label": "Launch Desktop Windows",
          "type": "shell",
          "arg": "DEFAULT_SESSION_JSON=\"$HOME/.local/share/default-session/default-session.json\" \"$HOME/.local/share/default-session/default-session-launcher.sh\""
        },
        {
          "label": "Edit Session Layout",
          "type": "xdg",
          "arg": "{FLAKE_DESKTOP}/src/modules/desktop/default-session.json"
        }
      ]
    },
    {
      "title": "Nix",
      "items": [
        {
          "label": "List Generations",
          "type": "shell",
          "arg": "/run/wrappers/bin/sudo nix-env -p /nix/var/nix/profiles/system --list-generations"
        },
        {
          "label": "GC (system)",
          "type": "shell",
          "arg": "/run/wrappers/bin/sudo nix-collect-garbage -d"
        },
        {
          "label": "Build Log",
          "type": "log",
          "arg": ""
        }
      ]
    },
    {
      "title": "System",
      "items": [
        {
          "label": "Failed Services",
          "type": "shell",
          "arg": "systemctl --failed --no-pager"
        },
        {
          "label": "Journal (errors)",
          "type": "shell",
          "arg": "journalctl -p err..emerg -n 50 --no-pager"
        },
        {
          "label": "Journal (boot)",
          "type": "shell",
          "arg": "journalctl -b --no-pager | tail -100"
        },
        {
          "label": "System Resources",
          "type": "shell",
          "arg": "free -h && echo && df -h / /nix"
        },
        {
          "label": "Reboot",
          "type": "shell",
          "arg": "/run/wrappers/bin/sudo systemctl reboot"
        },
        {
          "label": "Logout (KDE)",
          "type": "shell",
          "arg": "loginctl terminate-user $USER"
        }
      ]
    },
    {
      "title": "Open",
      "items": [
        {
          "label": "Open Flake Folder",
          "type": "xdg",
          "arg": "{FLAKE}"
        }
      ]
    }
  ]
}
