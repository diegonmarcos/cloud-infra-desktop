# ═══════════════════════════════════════════════════════════════════════════
# GUI Applications Container
# Consolidated from da_app_gui + db_apps_gui_2 (GUI/Desktop categories)
#
# Build:  podman build -t gui-apps -f Containerfile .
# Run:    podman compose up -d
# Enter:  podman exec -it gui-apps bash
# ═══════════════════════════════════════════════════════════════════════════

FROM registry.fedoraproject.org/fedora:41

LABEL maintainer="Diego Nepomuceno Marcos"
LABEL description="GUI applications container — Flatpak apps + native KDE/Qt apps + X11/VNC"

# ─── Base Dependencies ───────────────────────────────────────────────────
RUN dnf install -y \
    bash sudo curl wget ca-certificates \
    xdg-utils dbus-x11 \
    mesa-dri-drivers mesa-vulkan-drivers \
    pipewire pipewire-pulseaudio \
    && dnf clean all

# ─── X11/Wayland + VNC Desktop ──────────────────────────────────────────
RUN dnf install -y \
    xorg-x11-server-Xorg xorg-x11-xinit \
    openbox dmenu x11vnc \
    dejavu-fonts-all breeze-icon-theme \
    && dnf clean all

# ─── Native KDE/Qt GUI Apps ─────────────────────────────────────────────
RUN dnf install -y \
    konsole5 dolphin okular krita filelight \
    virt-manager \
    && dnf clean all

# ─── Flatpak Runtime ─────────────────────────────────────────────────────
RUN dnf install -y flatpak && dnf clean all
RUN flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# ─── Flatpak: Browsers ──────────────────────────────────────────────────
RUN flatpak install -y --noninteractive flathub com.brave.Browser

# ─── Flatpak: Office & Productivity ─────────────────────────────────────
RUN flatpak install -y --noninteractive flathub org.libreoffice.LibreOffice
RUN flatpak install -y --noninteractive flathub md.obsidian.Obsidian

# ─── Flatpak: Development ───────────────────────────────────────────────
RUN flatpak install -y --noninteractive flathub com.visualstudio.code

# ─── Flatpak: Communication ─────────────────────────────────────────────
RUN flatpak install -y --noninteractive flathub org.mozilla.Thunderbird
RUN flatpak install -y --noninteractive flathub com.slack.Slack

# ─── Flatpak: Media ─────────────────────────────────────────────────────
RUN flatpak install -y --noninteractive flathub com.spotify.Client

# ─── Flatpak: VPN ───────────────────────────────────────────────────────
RUN flatpak install -y --noninteractive flathub com.protonvpn.www

# ─── Cleanup ─────────────────────────────────────────────────────────────
RUN flatpak uninstall --unused -y || true && \
    rm -rf /var/tmp/flatpak-cache-*

# ─── User Setup ──────────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER user
WORKDIR /home/user
ENV SHELL=/bin/bash
CMD ["/bin/bash"]
