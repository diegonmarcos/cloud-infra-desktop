# Android init service: applies the baked layout + theme ONCE, after the framework is up.
# Placed at /system/etc/init/ (auto-imported). Triggers on sys.boot_completed=1 — Launcher3
# has started and created its favorites DB, so the baked layout SQL can be applied to it.
service redroid_cloud_seed /system/bin/sh /system/etc/redroid-cloud/seed.sh
    class late_start
    user root
    group root system
    seclabel u:r:magisk:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start redroid_cloud_seed
