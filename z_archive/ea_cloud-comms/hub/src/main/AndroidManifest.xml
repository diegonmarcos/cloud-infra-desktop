<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for the in-app fleet updater (GHCR OCI HTTP API). The hub
         itself does no sync; the forks own all server traffic. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Configs → About → Wi-Fi section (WifiManager RSSI / link speed /
         frequency rows — same section Cloud-SuperApp's About shows). SSID
         additionally needs ACCESS_FINE_LOCATION on Android 10+, which the hub
         deliberately does NOT declare — that row degrades to a hint instead. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Fleet updater: install hub + fork APKs via PackageInstaller (user
         prompt), and post the download/result notification. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Configs → About → Permissions: "Battery No Optimization" action button
         (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS one-tap dialog) — same
         whitelist flow Cloud-SuperApp's About exposes, so the periodic fleet
         updater keeps running under Doze. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Configs → About → Permissions: "Usage stats" status row + "Set Usage
         Access" button. Declaring PACKAGE_USAGE_STATS (a signature|privileged
         appop-backed perm) is what lets the hub appear in Settings → Special
         access → Usage access so the user can toggle it; the appop check
         (OPSTR_GET_USAGE_STATS) then reflects the live grant. Same row
         Cloud-SuperApp's About exposes. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Discover which fork APKs are installed (ForkRegistry.isInstalled +
         getLaunchIntentForPackage). One <package> per build.json::forks entry
         (manifest can't read JSON — keep in sync with the registry); scoped
         queries, no QUERY_ALL_PACKAGES needed. -->
    <queries>
        <package android:name="com.diegonmarcos.comms.mail" />
        <package android:name="com.diegonmarcos.comms.chat" />
        <package android:name="com.diegonmarcos.comms.matrix" />
        <package android:name="com.diegonmarcos.comms.dialer" />
        <!-- Stock upstream package ids (forks.<k>.upstream_apk.package) — the
             bundled upstream APKs install under THESE until our patched forks
             replace them; without visibility, installed-detection fails. -->
        <package android:name="com.mattermost.rnbeta" />
        <package android:name="io.element.android.x" />
        <package android:name="org.fossify.phone" />
    </queries>

    <!-- ── The IPC gate ──────────────────────────────────────────────────
         Custom permission, protectionLevel=signature: only apps signed with
         the SAME key (the forks + Cloud-SuperApp) can hold it, so only they
         can query the provider or bind the service. The name is injected from
         build.json/contract via the ${ipcPermission} manifest placeholder so
         it stays data-driven (one source of truth). -->
    <permission
        android:name="${ipcPermission}"
        android:protectionLevel="signature" />
    <!-- The hub also HOLDS the permission so it can query the per-fork
         exporter providers (which require the same permission). -->
    <uses-permission android:name="${ipcPermission}" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CloudComms"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press launcher icon → static shortcuts (update + about),
                 mirroring Cloud-SuperApp. The `update` shortcut is the
                 independent updater launcher icon. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Configs → About (build info, IPC contract, fleet status, updater). -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- PackageInstaller status callback for the fleet updater. -->
        <receiver
            android:name="com.diegonmarcos.comms.updater.PackageInstallerReceiver"
            android:exported="false" />

        <!-- Unified read surface. Exported but gated by the signature
             permission — SuperApp (same key) can query; anything else can't. -->
        <provider
            android:name=".CommsProvider"
            android:authorities="${ipcAuthority}"
            android:exported="true"
            android:permission="${ipcPermission}" />

        <!-- Action + push broker (AIDL). Same signature gate. -->
        <service
            android:name=".CommsService"
            android:exported="true"
            android:permission="${ipcPermission}"
            tools:ignore="ExportedService" />

    </application>
</manifest>
