#!/bin/bash
# =============================================================================
# BASHRC - Main Bash configuration
# Source: shell/bash/bashrc
# =============================================================================
# Modular configuration - sources separate files for organization
# =============================================================================

# Exit if not running interactively
[[ $- != *i* ]] && return

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
export LANG="${LANG:-en_US.UTF-8}"

# Path additions (deduplicated)
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"

# Container manager preference
export DBX_CONTAINER_MANAGER="${DBX_CONTAINER_MANAGER:-docker}"

# =============================================================================
# SHELL OPTIONS
# =============================================================================
shopt -s histappend        # Append to history, don't overwrite
shopt -s checkwinsize      # Update LINES and COLUMNS after each command
shopt -s globstar 2>/dev/null  # Enable ** for recursive globbing
shopt -s cdspell           # Autocorrect typos in cd
shopt -s dirspell 2>/dev/null  # Autocorrect directory names

# History settings
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
HISTIGNORE="ls:ll:la:cd:pwd:exit:clear:c"

# =============================================================================
# DETERMINE CONFIG DIRECTORY
# =============================================================================
# Support both NixOS home-manager and standalone installations
if [ -d "$HOME/.config/shell/bash" ]; then
    SHELL_CONFIG_DIR="$HOME/.config/shell/bash"
elif [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/bash" ]; then
    SHELL_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bash"
else
    # Fallback to directory containing this file
    SHELL_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# =============================================================================
# SOURCE MODULAR CONFIGURATION FILES
# =============================================================================

# Aliases
if [ -f "$SHELL_CONFIG_DIR/aliases.bash" ]; then
    source "$SHELL_CONFIG_DIR/aliases.bash"
elif [ -f "$HOME/.bash_aliases" ]; then
    source "$HOME/.bash_aliases"
fi

# Functions
if [ -f "$SHELL_CONFIG_DIR/functions.bash" ]; then
    source "$SHELL_CONFIG_DIR/functions.bash"
fi

# External tool integrations (starship, wakatime, nvm, cargo, etc.)
if [ -f "$SHELL_CONFIG_DIR/integrations.bash" ]; then
    source "$SHELL_CONFIG_DIR/integrations.bash"
fi

# Startup/Welcome screen (should be last)
if [ -f "$SHELL_CONFIG_DIR/startup.bash" ]; then
    source "$SHELL_CONFIG_DIR/startup.bash"
fi

# =============================================================================
# LOCAL OVERRIDES
# =============================================================================
# Source local customizations if they exist (not tracked in git)
if [ -f "$HOME/.bashrc.local" ]; then
    source "$HOME/.bashrc.local"
fi
