-async function workflowsGhaTrigger(workflowName?: string): Promise<string> {
+// `inputs` become `gh workflow run -f k=v` pairs. gh() spawns via execAsync with
+// an argv ARRAY (no shell), so there is no shell-injection surface — but a key
+// beginning with "-" would still be parsed by gh as a FLAG, so keys are
+// validated and newlines rejected rather than trusted.
+function encodeInputs(inputs?: Record<string, string>): { args: string[]; error?: string } {
+  const args: string[] = [];
+  for (const [k, v] of Object.entries(inputs ?? {})) {
+    if (!/^[A-Za-z_][A-Za-z0-9_-]*$/.test(k)) {
+      return { args: [], error: `invalid input name "${k}" — must match [A-Za-z_][A-Za-z0-9_-]*` };
+    }
+    if (/[\r\n]/.test(v)) {
+      return { args: [], error: `input "${k}" contains a newline` };
+    }
+    args.push("-f", `${k}=${v}`);
+  }
+  return { args };
+}
