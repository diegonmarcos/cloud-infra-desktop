+
+// Re-runs an existing run. `failedOnly` maps to `gh run rerun --failed`, which
+// is what you want for a transient infrastructure failure (upstream registry
+// 5xx/403, cache backend outage) — it retries only the jobs that failed instead
+// of paying for the whole matrix again.
+async function workflowsGhaRerun(runId: string, failedOnly = true, repo = GH_REPO): Promise<string> {
+  if (!/^\d+$/.test(runId)) return `✗ invalid run id "${runId}" — expected digits`;
+  const args = ["run", "rerun", runId, "--repo", repo];
+  if (failedOnly) args.push("--failed");
+  const r = await gh(args, 20_000);
+  if (r.ok) return `✓ Re-ran ${failedOnly ? "failed jobs of " : ""}run ${runId} in ${repo}`;
+  return `✗ Failed to rerun ${runId} — ${r.stderr.trim() || r.stdout.trim()}`;
+}
+
+// ──────────────────────────────────────────────────────────────────────────────
+// TOOL: workflows_gha_cancel
+// ──────────────────────────────────────────────────────────────────────────────
+
+// Completes the control surface: without cancel, a run started in error (wrong
+// ref, wrong inputs, a stuck matrix burning runner minutes) could only be
+// stopped from the web UI.
+async function workflowsGhaCancel(runId: string, repo = GH_REPO): Promise<string> {
+  if (!/^\d+$/.test(runId)) return `✗ invalid run id "${runId}" — expected digits`;
+  const r = await gh(["run", "cancel", runId, "--repo", repo], 20_000);
+  if (r.ok) return `✓ Cancelled run ${runId} in ${repo}`;
+  return `✗ Failed to cancel ${runId} — ${r.stderr.trim() || r.stdout.trim()}`;
+}
+
+// ──────────────────────────────────────────────────────────────────────────────
+// TOOL: workflows_gha_run_logs
+// ──────────────────────────────────────────────────────────────────────────────
+
+// gha_errors only covers runs from the last 24h. Diagnosing a SPECIFIC run
+// (including one older than that, or one still being investigated) previously
+// meant leaving the MCP for the GitHub web UI.
+async function workflowsGhaRunLogs(runId: string, failedOnly = true, repo = GH_REPO): Promise<string> {
+  if (!/^\d+$/.test(runId)) return `✗ invalid run id "${runId}" — expected digits`;
+  const view = await gh(
+    ["run", "view", runId, "--repo", repo, "--json", "displayTitle,status,conclusion,headSha,event,url"],
+    15_000,
+  );
+  const header = view.ok ? view.stdout.trim() : `(could not read run metadata: ${view.stderr.trim()})`;
+  const logs = await gh(
+    ["run", "view", runId, "--repo", repo, ...(failedOnly ? ["--log-failed"] : ["--log"])],
+    60_000,
+  );
+  const body = logs.ok ? logs.stdout : `(no logs: ${logs.stderr.trim()})`;
+  // Tail it — a full matrix log is megabytes and would swamp the caller.
+  const lines = body.split("\n");
+  const tail = lines.length > 400 ? ["…", `(${lines.length - 400} earlier lines trimmed)`, ...lines.slice(-400)] : lines;
+  return `RUN ${runId} — ${repo}\n${"═".repeat(70)}\n${header}\n\n${tail.join("\n")}`;
+}
