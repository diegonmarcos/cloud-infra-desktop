{
  "meta": {
    "name": "my-konsole",
    "version": "2.0",
    "target": "Surface Pro 8",
    "nixos": "24.11",
    "kernel": "linux-surface (via nixos-hardware)",
    "estimated_size": "~600-700MB",
    "boot_modes": ["normal", "copytoram"]
  },
  "credentials": {
    "diego": {
      "password": "1234567890",
      "shell": "fish",
      "groups": ["wheel", "networkmanager", "video", "input", "audio"],
      "sudo": "NOPASSWD"
    },
    "root": {
      "password": "1234567890"
    }
  },
  "boot": {
    "display_manager": "none (startx)",
    "window_manager": "openbox",
    "auto_login": "console (getty)"
  },
  "hardware": {
    "kernel": "linux-surface (nixos-hardware module)",
    "touch": "iptsd",
    "graphics": "i915 (Intel)",
    "wifi": "iwd + NetworkManager",
    "bluetooth": "disabled (slim)"
  },
  "packages": {
    "shells": ["fish", "bash"],
    "editors": ["vim", "nano"],
    "network": ["networkmanager", "nmtui", "iwd", "openssh", "curl", "wget", "git"],
    "gui": {
      "window_manager": "openbox",
      "terminal": "alacritty (my-konsole; Rust/GPU)",
      "terminal_tty": "cage -s -- alacritty (GPU terminal on raw TTY, no X11)",
      "file_manager": "pcmanfm",
      "browser": "surf",
      "launcher": "dmenu",
      "wifi_gui": "nm-connection-editor"
    },
    "cli_tools": ["btop", "htop", "ripgrep", "fzf", "jq", "tmux", "neofetch"],
    "disk_tools": ["parted", "gptfdisk", "btrfs-progs", "cryptsetup", "e2fsprogs", "dosfstools", "ntfs3g"],
    "recovery": ["testdisk", "ddrescue"],
    "dev": ["nodejs_22", "gcc", "gnumake", "pkg-config"]
  },
  "claude": {
    "install_method": "npx wrapper",
    "command": "claude"
  },
  "services": {
    "enabled": ["NetworkManager", "sshd", "iptsd"],
    "disabled": ["pipewire", "bluetooth", "sddm"]
  },
  "openbox": {
    "shortcuts": {
      "Super+Return": "alacritty (terminal)",
      "Super+E": "pcmanfm (files)",
      "Super+B": "surf (browser)",
      "Super+D": "dmenu_run (launcher)",
      "Super+W": "nm-connection-editor (WiFi)",
      "Super+Q": "close window",
      "Alt+Tab": "switch windows"
    },
    "menu": [
      {"label": "Terminal", "command": "alacritty"},
      {"label": "Files", "command": "pcmanfm"},
      {"label": "Browser", "command": "surf https://claude.ai"},
      {"separator": true},
      {"label": "WiFi Settings", "command": "nm-connection-editor"},
      {"label": "WiFi (nmtui)", "command": "alacritty -e nmtui"},
      {"label": "Claude Code", "command": "alacritty -e claude"},
      {"label": "System Monitor", "command": "alacritty -e btop"},
      {"separator": true},
      {"label": "Recovery submenu", "items": ["Unlock LUKS", "Mount Pool", "Disk Usage"]},
      {"separator": true},
      {"label": "Reboot", "command": "systemctl reboot"},
      {"label": "Shutdown", "command": "systemctl poweroff"}
    ]
  },
  "build": {
    "command": "./build.sh",
    "output": "my-konsole.iso",
    "uses_cached_kernel": true
  },
  "partition": {
    "_note": "Dedicated on-disk rescue slot (Surface Pro 8 nvme). `build.sh install-partition` rsyncs the whole live-ISO fs onto it and relabels it to volume_label so the ISO's baked GRUB finds nix-store.squashfs by isoImage.volumeID. rEFInd + GRUB chainload its /EFI/boot/bootx64.efi via the stable partition UUID (see ~/git/cloud-unix/aa_bootloader/src/boot.json grub.menu.mykonsole). Reversible: wipefs p8 + drop the boot.json entries.",
    "device": "/dev/nvme0n1p8",
    "uuid": "27ffc22b-f89e-492d-aeda-2341e8eba898",
    "volume_label": "MY_KONSOLE",
    "efi_binary": "/EFI/BOOT/BOOTX64.EFI",
    "mkfs": {
      "_reason": "rEFInd 0.14.2's bundled ext4_x64.efi is a READ-ONLY driver that refuses to mount any filesystem carrying an INCOMPAT feature bit it doesn't recognize. `metadata_csum_seed` = EXT4_FEATURE_INCOMPAT_CSUM_SEED — exactly such a bit — and modern mke2fs (e2fsprogs >=1.47) enables it plus `orphan_file` by default. Evidence (2026-07-26): p8 carried both and rEFInd errored 'Invalid Loader File' selecting the my-konsole entry; p5 (older mke2fs, lacks both, keeps metadata_csum) IS read by the SAME rEFInd driver. p8's fs was created ad-hoc — no engine owned it — so its features were unmanaged. install-partition now reformats p8 with these two features OFF before the rsync (which --delete-owns 100% of p8 anyway), making the fs reproducible + rEFInd-mountable. -U preserves partition.uuid so the safety guard and GRUB efi_uuid stay valid; PARTUUID lives in the GPT and is untouched.",
      "enabled": true,
      "type": "ext4",
      "disable_features": ["orphan_file", "metadata_csum_seed"]
    },
    "iso_release": "my-konsole-iso-latest",
    "iso_manifest": "my-konsole-iso.sha256",
    "iso_repo": "diegonmarcos/cloud-unix"
  }
}
