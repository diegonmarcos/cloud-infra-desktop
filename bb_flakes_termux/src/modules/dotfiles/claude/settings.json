{
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "env": {
    "NODE_PATH": "/data/data/com.termux.nix/files/home/.node_modules/node_modules",
    "GIT_BASE": "/data/data/com.termux.nix/files/home/git",
    "AUTHELIA_OIDC_CREDENTIALS_DIR": "/data/data/com.termux.nix/files/home/git/vault/A0_keys/providers/authelia/signed-bearer_jwt/credentials",
    "AUTHELIA_OIDC_TOKENS_DIR": "/data/data/com.termux.nix/files/home/git/vault/A0_keys/providers/authelia/signed-bearer_jwt/tokens",
    "AUTHELIA_OIDC_CLIENT_ID": "claude-admin",
    "AUTHELIA_TOKEN_URL": "https://auth.diegonmarcos.com/api/oidc/token",
    "DISABLE_WORKFLOWS": "1",
    "DISABLE_ARTIFACT": "1",
    "DISABLE_BUNDLED_SKILLS": "1",
    "DISABLE_BUILTIN_AGENTS": "1",
    "DISABLE_ADVISOR_TOOL": "1",
    "DISABLE_CLAUDE_API_SKILL": "1",
    "DISABLE_CLAUDE_CODE_SKILL": "1",
    "DISABLE_POLICY_SKILLS": "1",
    "DISABLE_CRON": "1",
    "DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "DISABLE_AGENT_VIEW": "1",
    "DISABLE_SOURCE_CODE_PREVIEW": "1",
    "DISABLE_ATTACHMENTS": "1",
    "DISABLE_GIT_INSTRUCTIONS": "1",
    "DISABLE_LAUNCH_COMPOSER": "1"
  },
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "hooks-stack-framework-principles-cloud-ai-plugin@cloud-marketplace": true,
    "compression-cloud-ai-plugin@cloud-marketplace": true,
    "memory-system-cloud-ai-plugin@cloud-marketplace": true,
    "sub-agents-cloud-ai-plugin@cloud-marketplace": true,
    "skill-claude-api-plugin@cloud-marketplace": true,
    "ponytail@cloud-marketplace": true
  }
