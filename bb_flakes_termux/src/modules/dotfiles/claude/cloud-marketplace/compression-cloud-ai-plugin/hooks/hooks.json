{
  "description": "Data-driven hook engine — UserPromptSubmit + PreToolUse:Bash inject of the compact per-turn principles pointer. See scripts/hook-engine.sh.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/hook-engine.sh inject UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/hook-engine.sh inject PreToolUse",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
