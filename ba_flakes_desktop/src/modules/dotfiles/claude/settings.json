{
  "statusLine": {
    "type": "command",
    "command": "bash /home/diego/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "env": {
    "NODE_PATH": "/home/diego/.node_modules/node_modules",
    "GIT_BASE": "/home/diego/git",
    "AUTHELIA_OIDC_CREDENTIALS_DIR": "/home/diego/git/vault/A0_keys/providers/authelia/signed-bearer_jwt/credentials",
    "AUTHELIA_OIDC_TOKENS_DIR": "/home/diego/git/vault/A0_keys/providers/authelia/signed-bearer_jwt/tokens",
    "AUTHELIA_OIDC_CLIENT_ID": "claude-admin",
    "AUTHELIA_TOKEN_URL": "https://auth.diegonmarcos.com/api/oidc/token"
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/hook-engine.sh inject SessionStart",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$HOME\"/.claude/ponytail/hooks/ponytail-activate.js",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/hook-engine.sh inject UserPromptSubmit",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node \"$HOME\"/.claude/ponytail/hooks/ponytail-mode-tracker.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/hook-engine.sh inject PreToolUse",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/hook-engine.sh guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/hook-engine.sh nudge",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
