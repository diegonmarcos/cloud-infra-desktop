#!/bin/zsh
# =============================================================================
# ZSHRC - Main Zsh configuration
# Source: shell/zsh/zshrc
# =============================================================================
# Modular configuration - sources separate files for organization
# =============================================================================

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
export LANG="${LANG:-en_US.UTF-8}"

# Path additions (deduplicated)
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"

# Container manager preference
export DBX_CONTAINER_MANAGER="${DBX_CONTAINER_MANAGER:-docker}"

# Project paths
export path_to_my_git="${path_to_my_git:-/home/diego/Documents/Git/}"

# =============================================================================
# ZSH OPTIONS
# =============================================================================
setopt AUTO_CD              # cd by typing directory name
setopt AUTO_PUSHD           # Push directories onto stack
setopt PUSHD_IGNORE_DUPS    # Don't push duplicates
setopt PUSHD_SILENT         # Don't print directory stack
setopt CORRECT              # Command correction
setopt EXTENDED_GLOB        # Extended globbing
setopt NO_BEEP              # No beep on error
setopt HIST_IGNORE_DUPS     # Ignore duplicate history entries
setopt HIST_IGNORE_SPACE    # Ignore commands starting with space
setopt SHARE_HISTORY        # Share history between sessions
setopt APPEND_HISTORY       # Append to history file

# History settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=20000

# =============================================================================
# DETERMINE CONFIG DIRECTORY
# =============================================================================
# Support both NixOS home-manager and standalone installations
if [[ -d "$HOME/.config/shell/zsh" ]]; then
    SHELL_CONFIG_DIR="$HOME/.config/shell/zsh"
elif [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/zsh" ]]; then
    SHELL_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
else
    # Fallback to directory containing this file
    SHELL_CONFIG_DIR="${0:A:h}"
fi

# =============================================================================
# SOURCE MODULAR CONFIGURATION FILES
# =============================================================================

# Integrations first (includes oh-my-zsh, p10k which need early loading)
if [[ -f "$SHELL_CONFIG_DIR/integrations.zsh" ]]; then
    source "$SHELL_CONFIG_DIR/integrations.zsh"
fi

# Aliases
if [[ -f "$SHELL_CONFIG_DIR/aliases.zsh" ]]; then
    source "$SHELL_CONFIG_DIR/aliases.zsh"
fi

# Functions
if [[ -f "$SHELL_CONFIG_DIR/functions.zsh" ]]; then
    source "$SHELL_CONFIG_DIR/functions.zsh"
fi

# C Development functions (optional, zsh-specific)
if [[ -f "$SHELL_CONFIG_DIR/functions-c-dev.zsh" ]]; then
    source "$SHELL_CONFIG_DIR/functions-c-dev.zsh"
fi

# Startup/Welcome screen (should be last)
if [[ -f "$SHELL_CONFIG_DIR/startup.zsh" ]]; then
    source "$SHELL_CONFIG_DIR/startup.zsh"
fi

# =============================================================================
# LOCAL OVERRIDES
# =============================================================================
# Source local customizations if they exist (not tracked in git)
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
