#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║ pre-push — force submodules to their upstream HEAD                ║
# ║                                                                  ║
# ║ Source: cloud/1_workflows/src/hooks/pre-push                     ║
# ║ Active via [core] hooksPath = 1_workflows/dist/hooks             ║
# ║                                                                  ║
# ║ Submodules are READ-ONLY / pull-only by design — no local commits ║
# ║ or edits should ever exist inside one (2026-08-07: a dirty        ║
# ║ V_front-configs kept aborting this hook's old `--rebase` update,  ║
# ║ which requires a clean worktree and just fell through to a        ║
# ║ non-blocking warning forever). Before every push, force-discard   ║
# ║ any local state in each submodule and reset it to its remote      ║
# ║ HEAD — never rebase/preserve. Pointer bumps in the parent repo    ║
# ║ are NOT auto-staged — that remains the responsibility of the GHA  ║
# ║ sync-submodules workflow on main. This hook only ensures the      ║
# ║ local worktree reflects upstream before the push goes out.        ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail

# ── Safer-alternative reminder ──────────────────────────────────────
if [ -t 2 ]; then
  printf '\033[33m\n┌─ git push ─ tip ──────────────────────────────────────────────┐\n' >&2
  printf   '│ Prefer `git sync` — safer: auto-stash + rebase + submodules.  │\n' >&2
  printf   '│   git sync remote   (origin wins on conflict, default)        │\n' >&2
  printf   '│   git sync local    (local commits win on conflict)           │\n' >&2
  printf   '│   script: 1_workflows/dist/scripts/cloud-git-sync.sh          │\n' >&2
  printf   '└───────────────────────────────────────────────────────────────┘\033[0m\n' >&2
fi

# ── Pull/rebase before pushing ──────────────────────────────────────────────
# Ensures the push never fails due to diverged remote — mirrors `git sync`.
if ! git pull --rebase --no-recurse-submodules 2>&1; then
  echo "[pre-push] pull --rebase failed — resolve conflicts then try again." >&2
  exit 1
fi

# Skip during interactive rebase / merge / bisect — don't compound state.
if [ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" ] \
   || [ -d "$(git rev-parse --git-path rebase-apply 2>/dev/null)" ] \
   || [ -f "$(git rev-parse --git-path MERGE_HEAD   2>/dev/null)" ] \
   || [ -f "$(git rev-parse --git-path BISECT_LOG   2>/dev/null)" ]; then
  exit 0
fi

# Skip if no submodules declared
[ -f .gitmodules ] || exit 0

echo "[pre-push] discarding any local submodule state, syncing to upstream HEAD..."
# Force-clean every initialized submodule first — read-only means no local
# commits/edits ever survive a push, so there is nothing to preserve or
# rebase. `update --remote` alone would abort (non-fast-forward / dirty
# worktree) instead of actually enforcing that; discard-then-update does.
git submodule foreach --recursive '
  git checkout -f -- . 2>/dev/null || true
  git clean -fdx 2>/dev/null || true
' || true
if ! git submodule update --init --recursive --remote --force; then
  echo "[pre-push] submodule sync reported errors — continuing (non-blocking)." >&2
fi
exit 0
