# Android init service that seeds the baked /data on first boot.
# Placed at /system/etc/init/ so init auto-imports it. Triggers at post-fs-data —
# the point where /data is mounted but before zygote/system_server start, so the
# apps + Launcher3 layout are already present the first time the framework comes up.
service redroid_cloud_seed /system/bin/sh /system/etc/redroid-cloud/seed.sh
    class core
    user root
    group root
    seclabel u:r:magisk:s0
    oneshot
    disabled

on post-fs-data
    start redroid_cloud_seed
