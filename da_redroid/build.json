  "theme": {
    "_doc": "dark_mode toggles Android night UI (cmd uimode night). AOSP 13's `cmd wallpaper` has NO set-image subcommand (only dim controls), so a generated image can't be pushed — instead we set wallpaper.dim (1.0 = fully black) via `cmd wallpaper set-dim-amount`, which reliably yields the requested solid-black background. auto_rotate is false: Redroid is a headless container with no accelerometer (the old da_waydroid-sensors HAL was dropped), so rotation is fixed by the container's configured resolution.",
    "dark_mode": true,
    "auto_rotate": false,
    "wallpaper": {
      "dim": 1,
      "size": "1280x800",
      "gradient_from": "#000000",
      "gradient_to": "#000000"
    }
  },
  "apps": [
    {
      "package": "com.diegonmarcos.superapp",
      "label": "Cloud-SuperApp",
      "group": "core",
      "_doc": "Provisioning ONLY fetches the already-published x86 APK (signed with the canonical per-app CI key); it must NEVER build it locally or in GHA. A local gradle build here signs with the wrong (vault) key and Android then rejects the in-app updater's canonical-key updates. Re-run `build.sh lock <pkg>` to refresh the pin when the upstream release bumps.",
      "appops": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "_doc_appops": "Special app-ops to allow at install (separate from the -g runtime perms). REQUEST_INSTALL_PACKAGES lets Cloud-SuperApp sideload/install other APKs itself (it's the constellation hub/installer). Granted via `cmd appops set <pkg> <op> allow` by cmd_install.",
      "source": {
        "type": "github",
        "url": "https://github.com/diegonmarcos/unix/releases/download/latest/Cloud-SuperApp-x86_64.apk"
