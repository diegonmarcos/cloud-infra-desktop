{
  "project": {
    "name": "redroid-apps",
    "version": "0.3.0",
    "description": "Declarative, data-driven provisioning of a curated Android app set into the local Redroid (redroid/redroid Docker) container, plus a fully data-driven launcher layout (hotseat 'bottom bar' + home-screen workspace + folders) and theme (dark mode + solid-black wallpaper). Apps are pinned in src/apps.lock.json (F-Droid suggestedVersionCode + nix-prefetched sha256), fetched reproducibly by src/flake.nix, installed with `adb install`. The launcher layout is rendered from the `launcher` block below into Launcher3's `favorites` DB by the engine (folders=itemType 2, hotseat=container -101, workspace=container -100). NOTHING is hardcoded in the engine: app list, layout, folders, theme, F-Droid endpoints, the Redroid container knobs (image, data volume, adb address) and the launcher DB are all read from this file or discovered at runtime (the DB filename is grid-dependent, e.g. launcher_6_by_5.db, so it is globbed). Replaces the decommissioned Waydroid stack: no host Wayland session, no LXC, no binder-HAL sensors — Redroid is a headless container viewed via scrcpy over ADB."
  },
  "release": {
    "_doc": "GHA builds src#apks and publishes the APK set as one tarball on this rolling GitHub Release (workflow: 1_workflows/src/cicd/ship-redroid-apks.yml). When consume=true, `build.sh build` downloads it (verifying the bundled manifest.json == src/apps.lock.json) instead of fetching ~54 APKs from F-Droid locally; nix build is the fallback. Force a local build with REDROID_APKS_LOCAL=1.",
    "tag": "redroid-apks-latest",
    "asset": "redroid-apks.tar.gz",
    "title": "Redroid APK set (GHA-prebuilt)",
    "consume": true
  },
  "paths": {
    "src": "src",
    "dist": "dist",
    "apk_dir": "dist/apks",
    "lockfile": "src/apps.lock.json",
    "flake": "src",
    "backup_dir": "dist/backups",
    "wallpaper": "dist/wallpaper.png"
  },
  "fdroid": {
    "api_url": "https://f-droid.org/api/v1/packages",
    "repo_url": "https://f-droid.org/repo"
  },
  "redroid": {
    "_doc": "Redroid container knobs + AOSP Launcher3 constants. `image` is the BAKED GHCR image (apps + Launcher3 layout + theme baked into the image in CI — NOT runtime-installed); `build.sh up` = docker pull + docker run, ready like Waydroid, zero runtime install. `base_image` is the upstream redroid the bake builds FROM. `data_volume` is the HOST path bind-mounted to /data; the first-boot init seed (from the baked image) populates it once. During `bake` (CI only) the engine reads/writes the launcher DB there directly. launcher_db_glob is grid-dependent (launcher_<cols>_by_<rows>.db) so it MUST be globbed. Containers/itemTypes/launch_flags are AOSP Launcher3 constants. cpu_cores caps the container (docker --cpus). selinux=permissive lets the first-boot seed extract + restorecon /data. On-demand only — never auto-started (Waydroid's ghost-process bug).",
    "image": "ghcr.io/diegonmarcos/redroid-cloud:13",
    "base_image": "redroid/redroid:13.0.0-latest",
    "selinux": "permissive",
    "container_name": "redroid",
    "adb_addr": "127.0.0.1:5555",
    "adb_port": 5555,
    "data_volume": "/mnt/shared-lib/redroid/data",
    "dns": [
      "1.1.1.1",
      "9.9.9.9"
    ],
    "abi": "x86_64",
    "_doc_abi": "Device ABI. The bake extracts each app's bundled lib/<abi>/*.so into /system/app/<pkg>/lib/<abi>/ — system apps don't get PackageManager's native-lib extraction, so a bare APK with extractNativeLibs=true leaves libchrome.so / libdatastore_shared_counter.so unreachable and the app crashes on dlopen.",
    "use_memfd": true,
    "_doc_use_memfd": "androidboot.use_memfd=1 boot property. This host's mainline kernel (6.19.8) has no /dev/ashmem (removed from mainline Linux since 5.18); libcutils falls back to memfd, but without this property Chromium (Brave) calls an ashmem-only ioctl on the memfd fd and gets ENOTTY, self-exiting on launch. Verified working: redroid 13.0.0's getprop shows ro.boot.use_memfd=1 / sys.use_memfd=1 when set. Needed for full x86 APK compatibility (any Chromium/WebView-based app hits this, not just Brave).",
    "gpu_mode": "host",
    "cpu_cores": 7,
    "width": 2304,
    "height": 1536,
    "dpi": 213,
    "fps": 60,
    "boot_gate_prop": "sys.boot_completed",
    "launcher_package": "com.android.launcher3",
    "home_package": "com.android.launcher3",
    "_doc_home": "Default HOME app. Stays launcher3 for now so the data-driven folder/workspace layout (cmd_layout writes launcher3's favorites DB) keeps working. PHASE 2 (after the launcher3 design is locked): flip to 'com.diegonmarcos.superapp' + run `build.sh home` to make Cloud-SuperApp the home launcher.",
    "launcher_db_glob": "data/com.android.launcher3/databases/launcher_*.db",
    "_doc_install": "Apps install via `adb install -r -d` (over adb_addr). grant_all_permissions adds `-g` so every declared runtime (dangerous) permission is auto-granted at install — no per-app permission prompts. For BAKED system apps (/system/app, no adb install) the first-boot seed instead grants every requested dangerous permission per app (pm grant loop over apps.list).",
    "grant_all_permissions": true,
    "_doc_home_experience": "First-boot home-screen experience knobs applied by the baked seed (data-driven, no runtime hacks). remove_qsb: disable the Google/QuickSearchBox widget so the launcher home has no search bar. location_enabled: turn Location services ON by default (mode 3 = high accuracy, gps+network providers allowed).",
    "remove_qsb": true,
    "location_enabled": true,
    "hotseat_container": -101,
    "workspace_container": -100,
    "item_type_application": 0,
    "item_type_folder": 2,
    "launch_flags": "0x10200000"
  },
  "image": {
    "_doc": "GHCR delivery of the BAKED redroid-cloud image (SYSTEM-APP bake — no Android boot, so it builds on any runner; GitHub-hosted runners have no binder and cannot boot redroid). CI (ship-redroid-image.yml) runs `build.sh bake`: fetch the APK set, lay them into /system/app, extract launcher activities statically via aapt, pre-render the Launcher3 layout SQL, docker-build src/Dockerfile; then verify (static, no boot) + push here. Runtime `up` pulls+runs; apps install at boot, the seed applies layout+theme on first boot. Matches the stack's 'every service is a GHCR image' rule.",
    "name": "ghcr.io/diegonmarcos/redroid-cloud",
    "tag": "13",
    "base": "redroid/redroid:13.0.0-latest",
    "dockerfile": "src/Dockerfile",
    "platforms": "linux/amd64"
  },
  "launcher": {
