#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║ pre-push — run the `git sync` engine before every push            ║
# ║                                                                  ║
# ║ Source: unix/1_workflows/src/hooks/pre-push                      ║
# ║ Active via [core] hooksPath (see cloud-git-hooks-install.sh —    ║
# ║ this hook is installed in EVERY repo: unix, cloud, cloud-data,   ║
# ║ cloud-data-lfs, front, front-data, vault, notes).                ║
# ║                                                                  ║
# ║ One engine, one behaviour everywhere: stash → fetch → rebase     ║
# ║ (ASK mode — prompts on conflict, local wins if no TTY) → pop →   ║
# ║ submodules. Step 4 (push) is SKIPPED via --no-push — git is      ║
# ║ already pushing; pushing again here would recurse.               ║
# ║                                                                  ║
# ║ Two guards make this safe:                                       ║
# ║  • CLOUD_GIT_SYNC_ACTIVE — set by the sync engine around its own ║
# ║    push, so `git sync` doesn't re-enter itself through this hook.║
# ║  • HEAD-moved abort — git resolved the ref to push BEFORE this   ║
# ║    hook ran, so if the rebase moved HEAD the in-flight push would║
# ║    carry a stale sha. Abort and tell the user to push again      ║
# ║    (only happens when you were actually behind origin).          ║
# ║                                                                  ║
# ║ That second push after a rebase is INTRINSIC to this hook model: ║
# ║ git compare-and-swaps refs/heads/<branch> against the sha it read║
# ║ BEFORE the hook ran, so nothing this hook does can make the      ║
# ║ in-flight push succeed once it has moved HEAD (verified          ║
# ║ 2026-08-09). `git push-sync` / `git.push` avoid it entirely by   ║
# ║ running the sync engine BEFORE git resolves the refs to push.    ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail

# The sync engine is already driving this push — don't re-enter.
[ "${CLOUD_GIT_SYNC_ACTIVE:-0}" = "1" ] && exit 0

# Skip mid-rebase / merge / bisect — never compound an in-progress operation.
if [ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" ] \
   || [ -d "$(git rev-parse --git-path rebase-apply 2>/dev/null)" ] \
   || [ -f "$(git rev-parse --git-path MERGE_HEAD   2>/dev/null)" ] \
   || [ -f "$(git rev-parse --git-path BISECT_LOG   2>/dev/null)" ]; then
  exit 0
fi

# WHAT IS ACTUALLY BEING PUSHED — from stdin, which this hook never read.
#
# git hands a pre-push hook one line per ref:
#     <local ref> <local sha> <remote ref> <remote sha>
# and <remote sha> is the LIVE value on the remote, because git has already
# talked to it by the time this runs. This hook ignored all of that and asked
# instead whether the CURRENT BRANCH was behind origin — then rebased the
# working tree if it was, even when the thing being pushed was not that branch
# and was already a fast-forward.
#
# That is not a harmless extra step. `pull --rebase` autostashes the working
# tree, and in a repo where another session has uncommitted work it stashes
# THEIRS, reapplies it, and can conflict or be killed half way through. Today
# it reverted an edit, and an OOM during one left a MERGE_AUTOSTASH ref behind
# that blocked every later pull.
#
# A push whose local commit already has the remote tip as an ancestor cannot
# be stale, by definition. Nothing needs integrating; let it through without
# touching the working tree at all.
_ff_only=1
_saw_ref=0
while read -r _lref _lsha _rref _rsha; do
  [ -z "$_lsha" ] && continue
  # An all-zero local sha is a branch DELETE, which pushes no commits.
  case "$_lsha" in *[!0]*) ;; *) continue ;; esac
  _saw_ref=1
  case "$_rsha" in
    # An all-zero remote sha means the ref does not exist there yet, so there
    # is nothing this push could be behind.
    *[!0]*)
      git merge-base --is-ancestor "$_rsha" "$_lsha" 2>/dev/null || _ff_only=0
      ;;
  esac
done
if [ "$_saw_ref" = 1 ] && [ "$_ff_only" = 1 ]; then
  echo "[pre-push] fast-forward — nothing to integrate, pushing."
  exit 0
fi

# Locate the engine. Repos other than unix have no 1_workflows/ of their own,
# so the shared hooks dir (hooks/ + scripts/ side by side) is the normal hit.
_hook_dir="$(cd "$(dirname "$0")" && pwd)"
for _c in \
    "${CLOUD_GIT_SYNC:-}" \
    "$_hook_dir/../scripts/cloud-git-sync.sh" \
    "$(git rev-parse --show-toplevel 2>/dev/null)/1_workflows/dist/scripts/cloud-git-sync.sh" \
    "$HOME/git/cloud-infra-desktop/1_workflows/dist/scripts/cloud-git-sync.sh"; do
  [ -n "$_c" ] && [ -x "$_c" ] && SYNC="$_c" && break
done

# Fast path: if we are not behind origin's copy of this branch, nothing can
# move HEAD, so neither the stash/rebase nor the submodule pass is needed for
# THIS push to be correct — skip straight to letting it through. This is the
# common case and where all the runtime and unreachable-private-submodule
# noise came from when the full sync ran on every push.
_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if git fetch origin --quiet --no-recurse-submodules; then
  if ! git rev-parse --quiet --verify "origin/$_branch" >/dev/null; then
    echo "[pre-push] new branch — nothing to integrate, pushing."
    exit 0
  fi
  _behind="$(git rev-list --count "HEAD..origin/$_branch" 2>/dev/null || echo 0)"
  if [ "$_behind" = "0" ]; then
    echo "[pre-push] up to date with origin/$_branch — nothing to integrate, pushing."
    exit 0
  fi
  echo "[pre-push] behind origin/$_branch by $_behind commit(s) — running the sync engine."
else
  echo "[pre-push] fetch failed (offline?) — falling back to the full sync engine." >&2
fi

_head_before="$(git rev-parse HEAD 2>/dev/null)"

if [ -n "${SYNC:-}" ]; then
  echo "[pre-push] running the sync engine (ask mode, --no-push)…"
  if ! "$SYNC" ask --no-push; then
    echo "[pre-push] sync failed — resolve the state above, then push again." >&2
    exit 1
  fi
else
  # Fallback: no engine reachable — do the minimum it guarantees.
  echo "[pre-push] sync engine not found — falling back to pull --rebase" >&2
  if ! git pull --rebase --no-recurse-submodules 2>&1; then
    echo "[pre-push] pull --rebase failed — resolve conflicts then try again." >&2
    exit 1
  fi
fi

# THE REBASE CAN SUCCEED AND STILL WRECK YOUR WORKING TREE.
#
# With rebase.autoStash on, `git pull --rebase` stashes the dirty worktree,
# rebases, then reapplies. If the incoming commits touched the same lines you
# were editing, that reapply conflicts — and git reports the REBASE's status,
# not the stash's. It prints "Applying autostash resulted in conflicts. Your
# changes are safe in the stash" and EXITS 0. The `if !` above cannot see it.
#
# What is left behind is a working tree full of <<<<<<< markers, a hook that
# says "just push again", and a push that then ships the markers. That has
# happened here twice, both times committing conflict markers into a source
# file. Unmerged index entries are the unambiguous signal, so check for them.
_unmerged="$(git ls-files -u | awk '{print $4}' | sort -u)"
if [ -n "$_unmerged" ]; then
  echo "" >&2
  echo "[pre-push] REFUSING TO PUSH — the rebase reapplied your stashed changes" >&2
  echo "[pre-push] with conflicts. These files hold <<<<<<< markers right now:" >&2
  echo "$_unmerged" | sed 's/^/[pre-push]     /' >&2
  echo "[pre-push]" >&2
  echo "[pre-push] Nothing is lost — your work is also kept in stash@{0}." >&2
  echo "[pre-push] The markers ARE the merge, so resolving them is the fix:" >&2
  echo "[pre-push]   edit the files, then  git add <them> && git stash drop" >&2
  echo "[pre-push] To start over from the rebased upstream state instead:" >&2
  echo "[pre-push]   git reset && git checkout -- .        (stash is kept)" >&2
  echo "[pre-push]" >&2
  echo "[pre-push] Note: plain \`git checkout -- .\` fails on unmerged paths, and" >&2
  echo "[pre-push] \`git stash pop\` just recreates the same conflict. Push again" >&2
  echo "[pre-push] only once this is clean — pushing now would ship the markers." >&2
  exit 1
fi

# Submodules are READ-ONLY / pull-only by design — no local commits or edits
# should ever exist inside one. The engine's step 6 uses `update --rebase`,
# which ABORTS on a dirty submodule worktree (2026-08-07: a dirty
# V_front-configs silently defeated it forever). Before a push goes out,
# force-discard local submodule state and reset to remote HEAD. Pointer bumps
# in the parent repo stay the GHA sync-submodules workflow's job.
if [ -f .gitmodules ]; then
  echo "[pre-push] discarding any local submodule state, syncing to upstream HEAD..."
  git submodule foreach --recursive '
    git checkout -f -- . 2>/dev/null || true
    git clean -fdx 2>/dev/null || true
  ' || true
  git submodule update --init --recursive --remote --force \
    || echo "[pre-push] submodule sync reported errors — continuing (non-blocking)." >&2
fi

# If the rebase moved HEAD, the sha git is about to push is stale.
_head_after="$(git rev-parse HEAD 2>/dev/null)"
if [ "$_head_before" != "$_head_after" ]; then
  echo "" >&2
  echo "[pre-push] HEAD moved during sync: ${_head_before:0:8} → ${_head_after:0:8}" >&2
  echo "[pre-push] Your branch was rebased onto origin, so THIS push would send a" >&2
  echo "[pre-push] stale commit. Nothing was lost — just run your push again." >&2
  echo "[pre-push] To skip this round-trip next time, push with \`git push-sync\`" >&2
  echo "[pre-push] (fish: \`git.push\`) — it syncs BEFORE git resolves the refs," >&2
  echo "[pre-push] so the ref is never stale and one command is enough." >&2
  exit 1
fi

exit 0
