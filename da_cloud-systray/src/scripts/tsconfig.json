{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": [],
    "types": []
  },
  "include": ["main.ts", "node.d.ts", "electron.d.ts"],
  "exclude": ["dist", "node_modules"]
}
