{
  "project": {
    "name": "waydroid-apps",
    "version": "0.2.0",
    "description": "Declarative, data-driven provisioning of a curated Android app set into the local Waydroid (LineageOS) container, plus a fully data-driven launcher layout (hotseat 'bottom bar' + home-screen workspace + folders) and theme (dark mode + generated dark wallpaper). Apps are pinned in src/apps.lock.json (F-Droid suggestedVersionCode + nix-prefetched sha256), fetched reproducibly by src/flake.nix, installed with `waydroid app install`. The launcher layout is rendered from the `launcher` block below into Launcher3's `favorites` DB by the engine (folders=itemType 2, hotseat=container -101, workspace=container -100). NOTHING is hardcoded in the engine: app list, layout, folders, theme, F-Droid endpoints, Waydroid data roots and the launcher DB are all read from this file or discovered at runtime (the DB filename is grid-dependent, e.g. launcher_6_by_5.db, so it is globbed)."
  },
  "paths": {
    "src": "src",
    "dist": "dist",
    "apk_dir": "dist/apks",
    "lockfile": "src/apps.lock.json",
    "flake": "src",
    "backup_dir": "dist/backups",
    "wallpaper": "dist/wallpaper.png"
  },
  "fdroid": {
    "api_url": "https://f-droid.org/api/v1/packages",
    "repo_url": "https://f-droid.org/repo"
  },
  "waydroid": {
    "_doc": "Host-side facts. data_roots is a candidate list; the engine picks the first that exists. launcher_db_glob is grid-dependent (launcher_<cols>_by_<rows>.db) so it MUST be globbed. Containers/itemTypes are AOSP Launcher3 constants. media_subdir is where the container's /sdcard lives on the host (used to stage the wallpaper).",
    "data_roots": [
      "/home/diego/.local/share/waydroid/data",
      "/var/lib/waydroid/data"
    ],
    "launcher_package": "com.android.launcher3",
    "launcher_db_glob": "data/com.android.launcher3/databases/launcher_*.db",
    "media_subdir": "media/0",
    "_doc_install": "`waydroid app install` is unreliable (silently no-ops, esp. for larger APKs — Organic Maps 72MB failed). The engine installs robustly by staging the APK into the container's tmp (container_tmp ↔ host <data_root>/local/tmp) and running `pm install -r -d`. grant_all_permissions adds `-g` so every declared runtime (dangerous) permission is auto-granted at install — no per-app permission prompts.",
    "container_tmp": "/data/local/tmp",
    "grant_all_permissions": true,
    "hotseat_container": -101,
    "workspace_container": -100,
    "item_type_application": 0,
    "item_type_folder": 2,
    "launch_flags": "0x10200000"
  },
  "launcher": {
    "_doc": "Data-driven Launcher3 layout. `folders` are reusable group definitions (members = package ids). `hotseat` is the bottom bar, left→right (ref = a package id or 'folder:<id>'). `workspace` is the home screen: screen 0, each cell placed at (cellX,cellY) on a 6-column grid; ref = package id or 'folder:<id>'. A folder ref placed in both hotseat and workspace yields two independent folder instances with the same title+members. Re-arrange by editing here + `build.sh layout` — no code changes.",
    "grid_columns": 6,
    "folders": {
      "cloud_ide": {
        "title": "Cloud IDE",
        "members": ["com.diegonmarcos.ide", "com.foxdebug.acode", "com.amaze.filemanager"]
      },
      "cloud_comms": {
        "title": "Cloud Comms",
        "members": [
          "com.diegonmarcos.comms",
          "im.vector.app",
          "com.mattermost.rnbeta",
          "eu.faircode.email",
          "org.fossify.phone",
          "org.fossify.contacts",
          "org.fossify.messages"
        ]
      },
      "cloud_nav": {
        "title": "Cloud Nav",
        "members": [
          "com.diegonmarcos.cloudnav",
          "app.organicmaps",
          "net.osmand.plus"
        ]
      },
      "stores": {
        "title": "Stores",
        "members": [
          "org.fdroid.fdroid",
          "com.aurora.store"
        ]
      },

      "_doc_phone": "SCREEN 1 (phone apps) folders. Titles come from ea_cloud-superapp/build.json::ui.phone_folders (single source of truth for the 31-category scheme used by the SuperApp's runtime PhoneAppClassifier); members here are the F-Droid-installable subset of the phone backup, classified by that same keyword algorithm. Proprietary apps (~274) are NOT installable from a reproducible source — install via Aurora Store inside Waydroid; they then auto-appear classified in the SuperApp's own drawer. Re-derive these member lists if phone_folders changes.",
      "phone_comm":     { "title": ".b0_Communication", "members": ["im.vector.app", "io.element.android.x", "com.fsck.k9", "rs.ltt.android", "com.mattermost.rnbeta", "io.heckel.ntfy"] },
      "phone_systools": { "title": "_SysTools",         "members": ["org.fdroid.fdroid", "com.ghostsq.commander", "org.kde.kdeconnect_tp", "com.termux.nix", "com.termux", "com.termux.api"] },
      "phone_ide":      { "title": ".a4_IDE|Code",       "members": ["com.viscouspot.gitsync"] },
      "phone_notes":    { "title": ".a2_Pages|Notes",    "members": ["com.adeeteya.markdown_editor"] },
      "phone_utility":  { "title": "-Utilities",         "members": ["me.zhanghai.android.files"] },
      "phone_security": { "title": "_Security",          "members": ["eu.faircode.netguard", "ch.protonvpn.android"] },
      "phone_sysinfo":  { "title": "_Sys_Info",          "members": ["me.biplobsd.rsm"] },
      "phone_misc":     { "title": "No Categorie",       "members": ["com.rama.mako", "org.fossify.phone"] }
    },
    "hotseat": [
      "com.diegonmarcos.superapp"
    ],
    "workspace": {
      "screen": 0,
      "cells": [
        { "ref": "com.diegonmarcos.superapp", "cellX": 0, "cellY": 0 },

        { "ref": "com.diegonmarcos.ide",      "cellX": 0, "cellY": 1 },
        { "ref": "folder:cloud_ide",          "cellX": 1, "cellY": 1 },
        { "ref": "com.foxdebug.acode",        "cellX": 2, "cellY": 1 },
        { "ref": "com.amaze.filemanager",     "cellX": 3, "cellY": 1 },

        { "ref": "com.diegonmarcos.comms",    "cellX": 0, "cellY": 2 },
        { "ref": "folder:cloud_comms",        "cellX": 1, "cellY": 2 },
        { "ref": "im.vector.app",             "cellX": 2, "cellY": 2 },
        { "ref": "com.mattermost.rnbeta",     "cellX": 3, "cellY": 2 },
        { "ref": "eu.faircode.email",         "cellX": 4, "cellY": 2 },
        { "ref": "org.fossify.messages",      "cellX": 5, "cellY": 2 },

        { "ref": "com.diegonmarcos.cloudnav", "cellX": 0, "cellY": 3 },
        { "ref": "folder:cloud_nav",          "cellX": 1, "cellY": 3 },
        { "ref": "app.organicmaps",           "cellX": 2, "cellY": 3 },
        { "ref": "net.osmand.plus",           "cellX": 3, "cellY": 3 },

        { "ref": "folder:stores",             "cellX": 0, "cellY": 4 },
        { "ref": "org.fdroid.fdroid",         "cellX": 1, "cellY": 4 },
        { "ref": "com.aurora.store",          "cellX": 2, "cellY": 4 },
        { "ref": "com.brave.browser",         "cellX": 3, "cellY": 4 },

        { "ref": "folder:phone_comm",     "screen": 1, "cellX": 0, "cellY": 0 },
        { "ref": "folder:phone_systools", "screen": 1, "cellX": 1, "cellY": 0 },
        { "ref": "folder:phone_security", "screen": 1, "cellX": 2, "cellY": 0 },
        { "ref": "folder:phone_ide",      "screen": 1, "cellX": 3, "cellY": 0 },
        { "ref": "folder:phone_notes",    "screen": 1, "cellX": 4, "cellY": 0 },
        { "ref": "folder:phone_utility",  "screen": 1, "cellX": 5, "cellY": 0 },
        { "ref": "folder:phone_sysinfo",  "screen": 1, "cellX": 0, "cellY": 1 },
        { "ref": "folder:phone_misc",     "screen": 1, "cellX": 1, "cellY": 1 }
      ]
    }
  },
  "theme": {
    "_doc": "dark_mode toggles Android night UI (cmd uimode night). AOSP 13's `cmd wallpaper` has NO set-image subcommand (only dim controls), so a generated image can't be pushed from the host — instead we set wallpaper.dim (1.0 = fully black) via `cmd wallpaper set-dim-amount`, which reliably yields the requested solid-black background. auto_rotate sets system accelerometer_rotation=1 so the screen follows the da_waydroid-sensors accelerometer HAL.",
    "dark_mode": true,
    "auto_rotate": true,
    "wallpaper": {
      "dim": 1,
      "size": "1280x800",
      "gradient_from": "#000000",
      "gradient_to": "#000000"
    }
  },
  "apps": [
    { "package": "com.diegonmarcos.superapp", "label": "Cloud-SuperApp", "group": "core",
      "source": { "type": "local", "build_project": "../ea_cloud-superapp", "build_variant_env": "SUPERAPP_VARIANT", "build_variant": "x86_64", "apk_glob": "dist/*x86_64*.apk" } },
    { "package": "com.diegonmarcos.cloudnav", "label": "Cloud-Nav", "group": "core",
      "source": { "type": "local", "build_project": "../ea_cloud-nav", "apk_glob": "dist/Cloud-Nav.apk" } },
    { "package": "com.diegonmarcos.comms", "label": "Cloud-Comms", "group": "core",
      "source": { "type": "local", "build_project": "../ea_cloud-comms", "apk_glob": "dist/Cloud-Comms-Hub.apk" } },
    { "package": "com.diegonmarcos.ide", "label": "Cloud-IDE", "group": "core",
      "source": { "type": "local", "build_project": "../ea_cloud-ide", "apk_glob": "dist/Cloud-IDE-Hub.apk" } },
    { "package": "com.foxdebug.acode",     "label": "Acode",            "group": "ide",   "source": { "type": "fdroid" } },
    { "package": "com.amaze.filemanager",  "label": "Amaze",            "group": "ide",   "source": { "type": "fdroid" } },
    { "package": "eu.faircode.email",      "label": "FairMail",         "group": "comms", "source": { "type": "fdroid" } },
    { "package": "com.mattermost.rnbeta",  "label": "Mattermost",       "group": "comms", "source": { "type": "fdroid" } },
    { "package": "im.vector.app",          "label": "Element",          "group": "comms", "source": { "type": "fdroid" } },
    { "package": "com.termux.nix",         "label": "Nix-on-Droid",     "group": "ide",   "source": { "type": "fdroid" } },
    { "package": "org.fossify.phone",      "label": "Fossify Phone",    "group": "comms", "source": { "type": "fdroid" } },
    { "package": "org.fossify.contacts",   "label": "Fossify Contacts", "group": "comms", "source": { "type": "fdroid" } },
    { "package": "org.fossify.messages",   "label": "Fossify Messages", "group": "comms", "source": { "type": "fdroid" } },
    { "package": "app.organicmaps",        "label": "Organic Maps",     "group": "nav",   "source": { "type": "fdroid" } },
    { "package": "net.osmand.plus",        "label": "OsmAnd~",          "group": "nav",   "source": { "type": "fdroid" } },
    { "package": "org.fdroid.fdroid",      "label": "F-Droid",          "group": "store", "source": { "type": "fdroid" } },
    { "package": "com.aurora.store",       "label": "Aurora Store",     "group": "store", "source": { "type": "fdroid" } },
    { "package": "com.brave.browser",      "label": "Brave",            "group": "web",   "source": { "type": "github", "url": "https://github.com/brave/brave-browser/releases/download/v1.91.172/BraveMonox64.apk" } },

    { "package": "io.element.android.x",     "label": "Element X",        "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.fsck.k9",              "label": "K-9 Mail",         "group": "phone", "source": { "type": "fdroid" } },
    { "package": "rs.ltt.android",           "label": "Ltt.rs",           "group": "phone", "source": { "type": "fdroid" } },
    { "package": "io.heckel.ntfy",           "label": "ntfy",             "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.ghostsq.commander",    "label": "Ghost Commander",  "group": "phone", "source": { "type": "fdroid" } },
    { "package": "org.kde.kdeconnect_tp",    "label": "KDE Connect",      "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.termux",               "label": "Termux",           "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.termux.api",           "label": "Termux:API",       "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.viscouspot.gitsync",   "label": "Git Sync",         "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.adeeteya.markdown_editor", "label": "Markdown Editor", "group": "phone", "source": { "type": "fdroid" } },
    { "package": "me.zhanghai.android.files","label": "Material Files",   "group": "phone", "source": { "type": "fdroid" } },
    { "package": "eu.faircode.netguard",     "label": "NetGuard",         "group": "phone", "source": { "type": "fdroid" } },
    { "package": "ch.protonvpn.android",     "label": "Proton VPN",       "group": "phone", "source": { "type": "fdroid" } },
    { "package": "me.biplobsd.rsm",          "label": "Resmush",          "group": "phone", "source": { "type": "fdroid" } },
    { "package": "com.rama.mako",            "label": "Mako",             "group": "phone", "source": { "type": "fdroid" } }
  ]
}
