{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-konsole",
  "version": "0.1.0",
  "identifier": "com.diegonmarcos.my-konsole",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "my-konsole",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "identifier": "com.diegonmarcos.my-konsole",
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
