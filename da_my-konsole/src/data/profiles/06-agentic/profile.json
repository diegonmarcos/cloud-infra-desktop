      "items": [
        { "label": "goose session", "cmd": "goose session" },
        { "label": "goose configure", "cmd": "goose configure" },
        { "label": "install goose", "cmd": "bash ~/git/tools/dtk.sh provision.goose" },
        { "label": "provision claude/gemini", "cmd": "bash ~/git/tools/dtk.sh provision.claude" }
      ]
    },
    {
