  "sections": [
    {
      "title": "CLAUDE CODE",
      "items": [
        { "label": "claude", "cmd": "claude" },
        { "label": "resume session", "cmd": "claude --resume" },
        { "label": "continue last", "cmd": "claude --continue" },
        { "label": "pick model", "cmd": "claude --model opus" },
        { "label": "claude in kg-bridge", "cmd": "ssh claude_oci-apps" },
        { "label": "claude-rescue chain", "cmd": "bash ~/git/tools/dtk.sh recover.claude-rescue" }
      ]
    },
    {
