{
  "name": "vault",
  "display_name": "Vault",
  "theme": {
    "accent": "#8e44ad"
  },
  "sections": [
    {
      "title": "Vault",
      "items": [
        {
          "label": "status",
          "cmd": "$HOME/git/vault/build.sh status"
        },
        {
          "label": "open in file manager",
          "cmd": "dolphin $HOME/git/vault"
        },
        {
          "label": "edit secrets (sops)",
          "cmd": "sops $HOME/git/unix/ba_flakes_desktop/src/secrets/secrets.yaml"
        },
        {
          "label": "list secret keys (no values)",
          "cmd": "sops -d --output-type json $HOME/git/unix/ba_flakes_desktop/src/secrets/secrets.yaml | jq keys"
        }
      ]
    }
  ],
  "order": 11
}
