{
  "name": "web-server",
  "display_name": "WebServer",
  "order": 25,
  "secondary": true,
  "theme": { "accent": "#00b894" },
  "_doc": "http-dev — the Node file server home-manager deploys (ba_flakes_desktop/src/modules/web-server-md-eruda.nix): a POSIX wrapper at ~/.local/bin/http-dev around `node ~/.local/bin/web-server-md-eruda.mjs <port> <dir>`, plus a systemd --user unit that wants the same :8000. The unit ships disabled and the wrapper is what actually runs, so these bookmarks drive the wrapper and keep the unit's state one click away — when the two do fight over the port, that has to be visible rather than a mystery.",
  "sections": [
    {
      "title": "SERVER",
      "items": [
        { "label": "status", "cmd": "http-dev status" },
        { "label": "start", "cmd": "http-dev start" },
        { "label": "stop", "cmd": "http-dev stop" },
        { "label": "restart", "cmd": "http-dev restart" },
        { "label": "open in browser", "cmd": "xdg-open http://127.0.0.1:8000" }
      ]
    },
    {
      "title": "SERVE A ROOT",
      "items": [
        { "label": "$HOME (default)", "cmd": "http-dev restart 8000 $HOME" },
        { "label": "~/git/unix", "cmd": "http-dev restart 8000 $HOME/git/unix" },
        { "label": "~/git/cloud", "cmd": "http-dev restart 8000 $HOME/git/cloud" },
        { "label": "~/git/front", "cmd": "http-dev restart 8000 $HOME/git/front" },
        { "label": "custom port + dir", "cmd": "http-dev restart " }
      ]
    },
    {
      "title": "DIAGNOSE",
      "items": [
        { "label": "who holds :8000", "cmd": "ss -tulpn | grep :8000" },
        { "label": "node process", "cmd": "ps -eo pid,etime,rss,args | grep '[w]eb-server-md-eruda'" },
        { "label": "pid file", "cmd": "cat ~/.cache/web-server-md-eruda.pid" },
        { "label": "run in foreground (logs)", "cmd": "node ~/.local/bin/web-server-md-eruda.mjs 8001 $HOME" }
      ]
    },
    {
      "title": "SYSTEMD UNIT",
      "items": [
        { "label": "unit status", "cmd": "systemctl --user status http-dev.service --no-pager" },
        { "label": "unit logs", "cmd": "journalctl --user -u http-dev.service -n 200 --no-pager" },
        { "label": "unit enabled?", "cmd": "systemctl --user is-enabled http-dev.service" }
      ]
    }
  ]
}
