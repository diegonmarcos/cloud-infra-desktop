    {
      "id": "httpd-web-server-json-md-eruda-systray",
      "icon": "httpd-web-server-json-md-eruda",
      "title": "httpd-web-server-json-md-eruda — local file server",
      "profile": "httpd-web-server-json-md-eruda",
      "enable": true,
      "default_command": "konsole --hold -e bash -lc \"httpd-web-server-json-md-eruda status; read\"",
      "_doc": "httpd-web-server-json-md-eruda is deployed by home-manager (ba_flakes_desktop/src/modules/httpd-web-server-json-md-eruda/default.nix) as BOTH a PID-file wrapper (~/.local/bin/httpd-web-server-json-md-eruda) and a systemd --user unit, which both want :8000. This menu drives the wrapper, because that is the one actually running today (the unit ships disabled), and shows the unit state next to it so the split is visible rather than a mystery when the two fight over the port.",
      "menu": [
        {
          "label": "Status",
          "command": "konsole --hold -e bash -lc \"httpd-web-server-json-md-eruda status; read\""
        },
        {
          "label": "Start",
          "command": "bash -lc \"httpd-web-server-json-md-eruda start && notify-send httpd-web-server-json-md-eruda \\\"serving :8000\\\"\""
        },
        {
          "label": "Stop",
          "command": "bash -lc \"httpd-web-server-json-md-eruda stop && notify-send httpd-web-server-json-md-eruda stopped\""
        },
        {
          "label": "Restart",
          "command": "bash -lc \"httpd-web-server-json-md-eruda restart && notify-send httpd-web-server-json-md-eruda restarted\""
        },
        {
          "label": "Open http://127.0.0.1:8000",
          "command": "xdg-open http://127.0.0.1:8000"
        },
        {
          "label": "Who holds :8000",
          "command": "konsole --hold -e bash -lc \"ss -tulpn | grep :8000 || echo \\\"nothing listening on 8000\\\"; read\""
        },
        {
          "label": "systemd unit: status",
          "command": "konsole --hold -e bash -lc \"systemctl --user status httpd-web-server-json-md-eruda.service --no-pager; read\""
        },
        {
          "label": "systemd unit: logs",
          "command": "konsole --hold -e bash -lc \"journalctl --user -u httpd-web-server-json-md-eruda.service -n 200 --no-pager; read\""
        }
      ]
    }
