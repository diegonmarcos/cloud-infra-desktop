{
    "_comment": "Per-mode cluster composition, read at runtime by main.qml (Qt.resolvedUrl + XMLHttpRequest). Each mode maps to { title, items[] }. 'kind' picks the QML component (pie | multipie | bargrid | rate | text) via main.qml's kindComponent() map; 'metric' picks which snapshot field(s) that component instance reads via main.qml's metric* helper functions. Adding a mode/item here is the intended way to grow this widget — it must not require another hardcoded Loader block in main.qml.",

    "storage": {
        "title": "Storage",
        "items": [
            { "kind": "bargrid", "metric": "disks", "columns": 1 },
            { "kind": "rate", "metric": "disk_io" }
        ]
    },
    "mem": {
        "title": "Memory",
        "items": [
            { "kind": "multipie", "metric": "mem" },
            { "kind": "pie", "metric": "swap" },
            { "kind": "pie", "metric": "slice" }
        ]
    },
    "cpu": {
        "title": "CPU",
        "items": [
            { "kind": "pie", "metric": "cpu" },
            { "kind": "pie", "metric": "vram" },
            { "kind": "text", "metric": "load" }
        ]
    },
    "network": {
        "title": "Network",
        "items": [
            { "kind": "rate", "metric": "net_io" }
        ]
    },
    "psi": {
        "title": "PSI",
        "items": [
            { "kind": "bargrid", "metric": "psi", "columns": 3 }
        ]
    },
    "guard": {
        "title": "Guard",
        "items": [
            { "kind": "bargrid", "metric": "guard", "columns": 4 }
        ]
    },
    "proctable": {
        "title": "Processes",
        "items": [
            { "kind": "text", "metric": "proctable_head" }
        ]
    }
}
