# Generated self-contained launcher (build.json baked in) — regenerated by
# `build.sh bundle` on every build, shipped inside the GHCR image. Not source.
/src/waydroid-launcher
# Fetched pinned APK set (regenerated by `build.sh apps-fetch` / `build.sh build` from
# src/apps/apps.lock.json — reproducible, so the output is never source) — baked into
# the image at /opt/apps/ by the Dockerfile.
/src/apks/
# Copy of the repo-root build.json into the build context (Dockerfile COPY target;
# entrypoint.sh reads it at runtime via jq) — regenerated by `build.sh build`, never
# hand-edited. build.json (repo root) stays the single source of truth.
/src/build.json
/dist/
