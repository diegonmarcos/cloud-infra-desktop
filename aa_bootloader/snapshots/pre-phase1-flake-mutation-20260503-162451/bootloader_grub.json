{
  "$schema": "./bootloader.schema.json",
  "description": "GRUB bootloader configuration - multi-OS menu entries",

  "grub": {
    "timeout": 5,
    "default": 0,
    "timeout_style": "menu",
    "gfxmode": "auto",
    "gfxpayload": "keep",
    "background_color": "#2F302F",
    "color_normal": "white/black",
    "color_highlight": "black/white"
  },

  "efi": {
    "mount_point": "/boot",
    "sys_mount_point": "/boot/efi",
    "can_touch_variables": true,
    "install_as_removable": false
  },

  "modules": {
    "required": [
      "part_gpt",
      "fat",
      "ext2",
      "btrfs",
      "luks2",
      "cryptodisk",
      "gcry_rijndael",
      "gcry_sha256",
      "chain",
      "search",
      "search_fs_uuid",
      "search_label",
      "configfile",
      "normal",
      "linux",
      "echo",
      "all_video",
      "efi_gop",
      "efi_uga",
      "gfxterm",
      "font",
      "png"
    ]
  },

  "entries": {
    "nixos": {
      "enabled": true,
      "default": true,
      "specialisations": ["rescue", "safe-graphics"],
      "source": "auto"
    },
    "arch": {
      "enabled": true,
      "label": "Arch OS",
      "root_uuid": "1648a2fb-f2ce-4da5-9966-645758a24929",
      "kernel": "/boot/vmlinuz-linux-surface",
      "initrd": "/boot/initramfs-linux-surface.img",
      "options": "rw",
      "recovery": {
        "enabled": true,
        "kernel": "/boot/vmlinuz-linux-surface",
        "initrd": "/boot/initramfs-linux-surface-fallback.img",
        "options": "rw single"
      }
    },
    "kali": {
      "enabled": true,
      "label": "Kali Linux",
      "root_uuid": "509491e4-d3a7-426d-9b78-4b024b24cc32",
      "kernel": "/vmlinuz",
      "initrd": "/initrd.img",
      "options": "ro quiet splash",
      "recovery": {
        "enabled": true,
        "modes": [
          {
            "label": "Kali (single user)",
            "options": "ro single"
          },
          {
            "label": "Kali (old kernel)",
            "kernel": "/vmlinuz.old",
            "initrd": "/initrd.img.old",
            "options": "ro quiet splash"
          }
        ]
      }
    },
    "windows": {
      "enabled": true,
      "label": "Windows Boot Manager",
      "type": "chainloader",
      "efi_uuid": "2CE0-6722",
      "efi_path": "/EFI/Microsoft/Boot/bootmgfw.efi"
    },
    "usb": {
      "enabled": true,
      "entries": [
        {
          "label": "Boot from USB (UEFI)",
          "type": "chainloader",
          "search_file": "/EFI/BOOT/BOOTX64.EFI",
          "efi_path": "/EFI/BOOT/BOOTX64.EFI"
        },
        {
          "label": "Boot from Ventoy USB",
          "type": "chainloader",
          "efi_uuid": "223C-F3F8",
          "efi_path": "/EFI/BOOT/BOOTX64.EFI"
        }
      ]
    },
    "firmware": {
      "enabled": true,
      "label": "UEFI Firmware Settings"
    }
  }
}
