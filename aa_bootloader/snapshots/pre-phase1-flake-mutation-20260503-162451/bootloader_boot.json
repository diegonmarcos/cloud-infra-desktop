{
  "$schema": "./bootloader.schema.json",
  "description": "Boot configuration - LUKS, initrd, kernel modules",

  "partitions": {
    "boot": {
      "uuid": "0eaf7961-48c5-4b55-8a8f-04cd0b71de07",
      "filesystem": "ext4",
      "mount": "/boot"
    },
    "efi": {
      "uuid": "2CE0-6722",
      "filesystem": "vfat",
      "mount": "/boot/efi"
    },
    "luks_pool": {
      "uuid": "3c75c6db-4d7c-4570-81f1-02d168781aac",
      "type": "luks2",
      "name": "pool"
    }
  },

  "luks": {
    "device": "pool",
    "uuid": "3c75c6db-4d7c-4570-81f1-02d168781aac",
    "keyfile": {
      "enabled": true,
      "usb_uuid": "223C-F3F8",
      "path": "/.luks/surface.key",
      "size": 4096,
      "timeout_seconds": 5
    },
    "fallback_to_password": true
  },

  "initrd": {
    "available_kernel_modules": [
      "xhci_pci", "thunderbolt", "nvme", "usb_storage", "sd_mod", "uas",
      "btrfs", "vfat", "fat", "nls_cp437", "nls_iso8859-1", "nls_utf8"
    ],
    "kernel_modules": [
      "dm-snapshot", "vfat", "fat", "nls_cp437", "nls_iso8859-1", "nls_utf8",
      "intel_lpss", "intel_lpss_pci", "8250_dw", "pinctrl_tigerlake", "xhci_pci",
      "surface_aggregator", "surface_aggregator_registry", "surface_aggregator_hub",
      "surface_hid_core", "surface_hid", "hid_multitouch", "hid_generic", "i2c_hid", "i2c_hid_acpi"
    ],
    "supported_filesystems": ["vfat"],
    "include_default_modules": true
  },

  "boot": {
    "kernel_modules": ["kvm-intel"],
    "extra_module_packages": []
  },

  "hibernate": {
    "enabled": true,
    "resume_device": "/dev/mapper/pool",
    "resume_offset": 4954822,
    "exclude_from_rescue": true
  },

  "surface_pro_8": {
    "keyboard_modules": [
      "surface_aggregator",
      "surface_aggregator_registry",
      "surface_aggregator_hub",
      "surface_hid_core",
      "surface_hid",
      "hid_multitouch",
      "hid_generic"
    ],
    "load_early": true
  }
}
