# aa_bootloader/.gitignore
# dist/ is regenerated from src/ via `./build.sh build-all`. Single SoT
# is src/boot.json — dist/ is purely ephemeral, never the source of truth.
# To inspect rendered output: run build-all locally and read dist/.

dist/

# Logs
logs/
!logs/.gitkeep

# Snapshots (user-captured /boot + NVRAM dumps; large, machine-specific)
snapshots/
!snapshots/.gitkeep
.snapshots/
